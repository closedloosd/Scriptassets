    local height = opts.Height or 28
    local base = opts.Color or Color3.fromRGB(38, 40, 56)
    local hover = opts.HoverColor or base:Lerp(Color3.new(1, 1, 1), 0.12)

    local btn = Instance.new("TextButton")
