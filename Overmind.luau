    end
    Internal.FriendsNotify("REFRESHING", true)
    task.spawn(function()
        Automation.FriendRefreshOnce(true)
    end)
end

Internal.FriendsRender = function()
    Automation.FriendRender()
end

-- Ultra-Aggressive Remote Debugger (Direct Method)
local remoteDebugEnabled = false
local function setupRemoteDebugger()
    pcall(function()
        local function logRemote(self, method, ...)
            if not remoteDebugEnabled then return end
            local args = {...}
            local name = tostring(self.Name)

            -- Вывод в консоль F9
            print("[OVERMIND SNIFFER] " .. name .. " (" .. method .. ")")
            for i, v in args do
                print("  > Arg " .. i .. ": " .. tostring(v) .. " [" .. type(v) .. "]")
            end

            -- Вывод в наше лог-окно
            _G.Log("Remote: " .. name, Color3.fromRGB(0, 255, 255))
        end

        -- Хук FireServer напрямую в класс RemoteEvent
        local oldFire
        oldFire = hookfunction(Instance.new("RemoteEvent").FireServer, newcclosure(function(self, ...)
            logRemote(self, "FireServer", ...)
            return oldFire(self, ...)
        end))

        -- Хук InvokeServer напрямую в класс RemoteFunction
        local oldInvoke
        oldInvoke = hookfunction(Instance.new("RemoteFunction").InvokeServer, newcclosure(function(self, ...)
            logRemote(self, "InvokeServer", ...)
            return oldInvoke(self, ...)
        end))

        _G.Log("Debugger: HOOKED SUCCESS", Color3.fromRGB(0, 255, 0))
    end)
end
setupRemoteDebugger()

function Automation.pickCarTerminal(lp)
    local terminal, promptObj = nil, nil
    local lpName, lpId = lp.Name, tostring(lp.UserId)
    local lpTeamName = lp.Team and lp.Team.Name or nil

    local function fixCarSpawnerEnabled(spawnerPart)
        if spawnerPart and spawnerPart:IsA("BasePart") then
            pcall(function()
                if not spawnerPart:FindFirstChild("Enabled") then
                    local bv = Instance.new("BoolValue")
                    bv.Name = "Enabled"
                    bv.Value = true
                    bv.Parent = spawnerPart
                    print("[OVERMIND] Fixed game bug: Created missing 'Enabled' BoolValue in " .. spawnerPart:GetFullName())
                end
            end)
        end
    end

    local function ownerOf(node)
        local curr = node
        local depth = 0
        while curr and depth < 8 do
            -- 1. Attributes
            local o = curr:GetAttribute("Owner")
            if o ~= nil then return tostring(o) end
            for _, attr in { "ownerId", "OwnerId", "ownerUserId", "OwnerUserId", "userId", "UserId", "Player", "Team" } do
                o = curr:GetAttribute(attr)
                if o ~= nil then return tostring(o) end
            end

            -- 2. ValueBase instances
            for _, childName in { "Owner", "owner", "OwnerValue", "Player", "TycoonOwner", "UserId", "userId", "OwnerUserId", "Team", "TeamValue" } do
                local val = curr:FindFirstChild(childName)
                if val and val:IsA("ValueBase") then
                    if val:IsA("ObjectValue") then
                        if val.Value == lp or val.Value == lp.Character then
                            return lpName
                        end
                    elseif val:IsA("StringValue") then
                        local sVal = tostring(val.Value)
                        if sVal:lower() == lpName:lower() or sVal == lpId or (lpTeamName and sVal:lower() == lpTeamName:lower()) then
                            return lpName
                        end
                    elseif val:IsA("IntValue") or val:IsA("NumberValue") then
                        if tostring(val.Value) == lpId then
                            return lpName
                        end
                    end
                end
            end

            -- 3. Model/Folder name matching lpName or lpTeamName (e.g. "Alpha"
            if curr:IsA("Model") or curr:IsA("Folder") then
                local nLower = curr.Name:lower()
                if nLower:find(lpName:lower(), 1, true) or (lpTeamName and (nLower == lpTeamName:lower() or nLower:find(lpTeamName:lower(), 1, true))) then
                    return lpName
                end
            end

            curr = curr.Parent
            depth += 1
        end
        return nil
    end

    -- 1. Сначала ищем СВОЙ ТАЙКУН в workspace (например
    local myTycoon = nil
    for _, obj in workspace:GetDescendants() do
        if obj:IsA("Model") and (obj.Parent and (obj.Parent.Name == "Tycoons" or obj.Parent.Name == "Tycoon" or obj.Parent.Name == "Bases")) then
            local o = ownerOf(obj)
            if o and (o == lpName or o == lpId or o:lower() == lpName:lower()) then
                myTycoon = obj
                print("[OVERMIND] My Tycoon found: " .. myTycoon:GetFullName())
                break
            end
        end
    end

    local searchScope = myTycoon and myTycoon:GetDescendants() or workspace:GetDescendants()
    local targetVeh = (Config.VehiclesFarm.Vehicle or "MRZR Buggy"):lower()

    -- Исправляем возможные отсутствующие Enabled во всех найденных спавнерах
    for _, v in ipairs(searchScope) do
        if v:IsA("BasePart") then
            local n = v.Name:lower()
            if n:find("spawner") or n:find("spawnpad") then
                fixCarSpawnerEnabled(v)
            end
        end
    end

    -- 2. Поиск спавнера в пределах СВОЕГО тайкуна под целевой тип техники (игнорируя дроны)
    local found = 0
    local candidates = {}

    for _, v in ipairs(searchScope) do
        if v:IsA("BasePart") then
            local n = v.Name:lower()
            local bad = (v:FindFirstAncestor("Drone") ~= nil) or (v:FindFirstAncestor("UAV") ~= nil) or n:find("drone")

            if not bad and (n == "carspawner" or n == "vehiclespawner" or n == "helispawner" or n == "planespawner" or n == "spawner") then
                found += 1
                local p = v:FindFirstChildOfClass("ProximityPrompt")
                    or (v.Parent and v.Parent:FindFirstChildOfClass("ProximityPrompt"))
                    or v:FindFirstChildWhichIsA("ProximityPrompt", true)

                local priority = 1
                if targetVeh:find("heli") or targetVeh:find("chopper") then
                    if n:find("heli") then priority = 10 end
                elseif targetVeh:find("plane") or targetVeh:find("jet") then
                    if n:find("plane") then priority = 10 end
                else
                    if n == "carspawner" or n == "vehiclespawner" then priority = 10 end
                end

                table.insert(candidates, { v = v, p = p, priority = priority })
            end
        end
    end

    table.sort(candidates, function(a, b) return a.priority > b.priority end)

    if #candidates > 0 then
        terminal = candidates[1].v
        promptObj = candidates[1].p
    end

    return terminal, promptObj, found
end

-- [ v46 ] ПРЯМОЙ СПАВН ТЕХНИКИ
function Automation.TryDirectMountSpawn(name)
    if type(name) ~= "string" or name == "" then return false end
    local fired = {}

    -- [ v82 ] снимок ДО спавна: по нему находим именно нашу новую модель, а не чужую с тем же именем
    local beforeSpawn = {}
    pcall(function()
        for _, m in ipairs(workspace:GetDescendants()) do
            if m:IsA("Model") and m.Name:lower():find(name:lower(), 1, true) then
                beforeSpawn[m] = true
            end
        end
    end)

    -- 1) СЫРОЙ РЕМОУТ
    pcall(function()
        local svc = RS:FindFirstChild("Packages")
        svc = svc and svc:FindFirstChild("Knit")
        svc = svc and svc:FindFirstChild("Services")
        svc = svc and svc:FindFirstChild("MountService")
        local refolder = svc and svc:FindFirstChild("RE")
        local remote = refolder and refolder:FindFirstChild("SpawnMount")
        if not remote then
            print("[SPAWN-DIRECT] not found " .. tostring(refolder and refolder:GetFullName() or "Knit.Services.MountService.RE") .. ".SpawnMount")
            return
        end
        if remote:IsA("RemoteEvent") then
            remote:FireServer(name)
            table.insert(fired, "raw:RemoteEvent " .. remote:GetFullName())
        elseif remote:IsA("RemoteFunction") then
            remote:InvokeServer(name)
            table.insert(fired, "raw:RemoteFunction " .. remote:GetFullName())
        end
    end)

    -- 2) если сырой ремоут не найден
    if #fired == 0 then
        pcall(function()
            local pk = RS:FindFirstChild("Packages")
            local knitMod = pk and pk:FindFirstChild("Knit")
            if not knitMod then return end
            local Knit = require(knitMod)
            local MountService = Knit.GetService("MountService")
            if MountService and MountService.SpawnMount and type(MountService.SpawnMount.Fire) == "function" then
                MountService.SpawnMount:Fire(name)
                table.insert(fired, "knit:SpawnMount")
            end
        end)
    end

    if #fired > 0 then
        task.spawn(function()
            local deadline = tick() + 4
            while tick() < deadline do
                task.wait(0.5)
                local found = nil
                pcall(function()
                    for _, m in ipairs(workspace:GetDescendants()) do
                        if m:IsA("Model") and m.Name:lower():find(name:lower(), 1, true) and not beforeSpawn[m] then
                            found = m
                            return
                        end
                    end
                end)
                if found then
                    Automation.VT.NoteSpawned(found)
                    print("[SPAWN-DIRECT] new model tracked: " .. found:GetFullName())
                    return
                end
            end
        end)
        print("[SPAWN-DIRECT] sent (" .. table.concat(fired, " | ") .. ") mount='" .. name .. "'")
        return true
    end
    print("[SPAWN-DIRECT] direct spawn unavailable -> falling back to the UI flow")
    return false
end
-- [ v48 ] TP AFTER SPAWN + авто-цикл после смерти
function Automation.ParseCFrameString(s)
    if type(s) ~= "string" or s == "" then return nil end
    local nums = {}
    for n in string.gmatch(s, "%-?%d+%.?%d*") do
        local v = tonumber(n)
        if v then
            nums[#nums + 1] = v
        end
        if #nums >= 12 then break end
    end
    if #nums >= 12 then
        local ok, cf = pcall(CFrame.new, nums[1], nums[2], nums[3], nums[4], nums[5], nums[6],
            nums[7], nums[8], nums[9], nums[10], nums[11], nums[12])
        if ok and cf then return cf end
    end
    if #nums >= 3 then
        local ok, cf = pcall(CFrame.new, nums[1], nums[2], nums[3])
        if ok and cf then return cf end
    end
    return nil
end

-- [ v49 ] Едем ли мы в технике прямо сейчас
function Automation.IsSeatedInVehicle()
    local lp = Core.LocalPlayer
    local char = lp and lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    if hum.SeatPart then return true end
    return hum.Sit == true
end

-- [ v82 ] UNIVERSAL VEHICLE TELEPORT (car / tank / helicopter / plane / boat / submarine)
-- Почему машина улетала «в рандомные корды»:
--   1) каждый ретрай заново искал технику сканом workspace по имени — и мог взять ЧУЖУЮ модель;
--   2) PivotTo на живую физику без блокировки: остаточная скорость и пружины подвески уносили машину;
--   3) пивот машины ставился ровно в точку HRP, поэтому танк/вертолёт оказывался в земле или в воздухе.
-- Теперь модель фиксируется один раз на весь телепорт, точка считается от поверхности (земля/вода),
-- части на пару кадров анкорятся, скорости обнуляются до и после, затем проверяется прибытие.
Automation.VT = Automation.VT or {}
Automation.VT.KindOrder = { "Auto", "Car", "Tank", "Heli", "Plane", "Boat", "Sub" }
Automation.VT.Busy = false
Automation.VT.SpawnedModel = nil
Automation.VT.SpawnedAt = 0

-- старые конфиги не знают новых полей: подставляем значения на месте
function Automation.VT.Cfg()
    local c = Config.VehiclesFarm
    if type(c) ~= "table" then
        c = {}
        Config.VehiclesFarm = c
    end
    if c.TpType ~= "Car" and c.TpType ~= "Tank" and c.TpType ~= "Heli" and c.TpType ~= "Plane"
        and c.TpType ~= "Boat" and c.TpType ~= "Sub" then
        c.TpType = "Auto"
    end
    c.TpSurface = (c.TpSurface ~= false)
    c.TpLevel = (c.TpLevel ~= false)
    c.TpAnchor = (c.TpAnchor ~= false)
    c.TpOffset = math.clamp(tonumber(c.TpOffset) or 0, -100, 200)
    c.TpAir = math.clamp(tonumber(c.TpAir) or 10, 0, 200)
    c.TpDepth = math.clamp(tonumber(c.TpDepth) or 8, 0, 100)
    c.TpAttempts = math.clamp(math.floor(tonumber(c.TpAttempts) or 4), 1, 10)
    return c
end

-- какую технику заспавнил сервер: запоминаем точную модель, чтобы TP не искал её по имени
function Automation.VT.NoteSpawned(model)
    if typeof(model) ~= "Instance" then return end
    Automation.VT.SpawnedModel = model
    Automation.VT.SpawnedAt = tick()
end

function Automation.VT.ModelFromSeat(seat, char)
    if not seat or typeof(seat) ~= "Instance" then return nil end
    local model = seat:FindFirstAncestorOfClass("Model")
    local guard = 0
    while model and char and (model == char or model:IsDescendantOf(char)) and guard < 8 do
        model = model.Parent and model.Parent:FindFirstAncestorOfClass("Model") or nil
        guard = guard + 1
    end
    return model
end

-- тип техники по имени модели, именам частей и атрибутам; ручной выбор в настройках главнее
function Automation.VT.ModelKind(model)
    local cfg = Automation.VT.Cfg()
    if cfg.TpType ~= "Auto" then return cfg.TpType end
    if not model or typeof(model) ~= "Instance" then return "Car" end

    local words = {}
    local function add(text)
        if type(text) == "string" and text ~= "" then words[#words + 1] = text:lower() end
    end

    add(model.Name)
    for _, child in ipairs(model:GetChildren()) do add(child.Name) end
    for _, key in ipairs({ "VehicleType", "MountType", "Type", "Class", "Kind", "Category", "Role" }) do
        local ok, val = pcall(function() return model:GetAttribute(key) end)
        if ok and type(val) == "string" then add(val) end
    end
    local scanned = 0
    for _, d in ipairs(model:GetDescendants()) do
        scanned = scanned + 1
        if scanned > 250 then break end
        add(d.Name)
    end

    local text = " " .. table.concat(words, " ") .. " "
    -- строгое слово: короткое «sub» не должно ловить «subpart»
    local function has(word)
        local from = 1
        while true do
            local at = text:find(word, from, true)
            if not at then return false end
            local before = (at == 1) and " " or text:sub(at - 1, at - 1)
            local after = text:sub(at + #word, at + #word)
            if not before:match("%a") and not after:match("%a") then return true end
            from = at + #word
        end
    end
    -- начало слова: «SubmarineHull» и «RotorBlade» тоже считаются
    local function starts(word)
        local from = 1
        while true do
            local at = text:find(word, from, true)
            if not at then return false end
            local before = (at == 1) and " " or text:sub(at - 1, at - 1)
            if not before:match("%a") then return true end
            from = at + #word
        end
    end

    if starts("submarine") or has("sub") or starts("uboat") then return "Sub" end
    if starts("helicopter") or starts("chopper") or starts("rotor") or starts("heli") then return "Heli" end
    if has("plane") or starts("aircraft") or has("jet") or starts("fighter") or starts("bomber")
        or starts("wing") or starts("aileron") or starts("rudder") or starts("turbine") then
        return "Plane"
    end
    if starts("tank") or has("mbt") or starts("apc") or has("ifv") or starts("turret") or starts("tread") or starts("tracks") then return "Tank" end
    if starts("boat") or starts("ship") or starts("yacht") or starts("vessel") or starts("hull") or has("speedboat") or starts("gunboat") then return "Boat" end
    return "Car"
end

function Automation.VT.Parts(model)
    if not model or typeof(model) ~= "Instance" then return {} end
    local parts = {}
    pcall(function()
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then
                parts[#parts + 1] = d
                if #parts >= 400 then break end
            end
        end
    end)
    return parts
end

-- пивот, габариты и расстояние от пивота до нижней точки модели
function Automation.VT.Metrics(model)
    local info = { pivot = nil, size = Vector3.zero, bottom = 0 }
    if not model or typeof(model) ~= "Instance" or not model.Parent then return info end
    pcall(function()
        local bbCF, bbSize = model:GetBoundingBox()
        local pivot = model:GetPivot()
        info.pivot = pivot
        info.size = bbSize
        info.bottom = math.max(0, pivot.Position.Y - (bbCF.Position.Y - bbSize.Y * 0.5))
    end)
    return info
end

-- что под точкой: земля или вода (вода важна лодкам и субмаринам)
function Automation.VT.SurfaceAt(pos, model)
    local params = RaycastParams.new()
    pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end)
    pcall(function() params.FilterType = Enum.RaycastFilterType.Blacklist end)
    local ignore = {}
    if model then ignore[#ignore + 1] = model end
    local lp = Core.LocalPlayer
    if lp and lp.Character then ignore[#ignore + 1] = lp.Character end
    pcall(function() params.FilterDescendantsInstances = ignore end)
    pcall(function() params.IgnoreWater = false end)

    local origin = Vector3.new(pos.X, pos.Y + 500, pos.Z)
    local ok, hit = pcall(function() return workspace:Raycast(origin, Vector3.new(0, -2000, 0), params) end)
    if ok and hit then
        return { y = hit.Position.Y, material = hit.Material, water = (hit.Material == Enum.Material.Water) }
    end
    return nil
end

-- итоговая точка: земля + высота до днища, вода для лодок/субмарин, воздух для вертолётов/самолётов
function Automation.VT.Solve(cf, model, kind)
    local cfg = Automation.VT.Cfg()
    local pos = cf.Position
    local rot = cf - pos

    if cfg.TpLevel then
        local okAngles, angles = pcall(function() return { cf:ToEulerAnglesYXZ() } end)
        local yaw = (okAngles and tonumber(angles[2])) or 0
        local okRot, leveled = pcall(function() return CFrame.fromEulerAnglesYXZ(0, yaw, 0) end)
        if okRot and leveled then rot = leveled end
    end

    local metrics = Automation.VT.Metrics(model)
    -- у персонажа HRP выше ступней: иначе после TP ноги уходят в землю
    local bottom = model and metrics.bottom or 3
    local y = pos.Y
    local surface = nil

    if cfg.TpSurface then
        surface = Automation.VT.SurfaceAt(pos, model)
        local groundY = surface and surface.y or pos.Y
        if kind == "Boat" then
            if surface and surface.water then
                y = groundY - bottom * 0.35
            else
                y = groundY + bottom
            end
        elseif kind == "Sub" then
            if surface and surface.water then
                y = groundY - (bottom + cfg.TpDepth)
            else
                y = groundY + bottom
            end
        elseif kind == "Heli" or kind == "Plane" then
            y = groundY + bottom + cfg.TpAir
        else
            y = groundY + bottom
        end
    end

    y = y + cfg.TpOffset
    return CFrame.new(Vector3.new(pos.X, y, pos.Z)) * rot, surface
end

function Automation.VT.ZeroVelocity(parts)
    for _, part in ipairs(parts or {}) do
        if part and part.Parent then
            pcall(function()
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end)
        end
    end
end

-- блокируем сборку на время перемещения: без этого физика уносит машину после PivotTo
function Automation.VT.Freeze(parts)
    local saved = {}
    for _, part in ipairs(parts or {}) do
        if part and part.Parent then
            local ok, wasAnchored = pcall(function() return part.Anchored end)
            if ok and not wasAnchored then
                saved[#saved + 1] = part
                pcall(function() part.Anchored = true end)
            end
        end
    end
    return saved
end

function Automation.VT.Unfreeze(saved)
    for _, part in ipairs(saved or {}) do
        if part and part.Parent then
            pcall(function() part.Anchored = false end)
        end
    end
end

-- сиденье, в котором мы сидим: сначала Humanoid.SeatPart, потом поиск по Occupant рядом с нами
function Automation.VT.SeatByOccupant(hum, char)
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return nil end
    local found = nil
    pcall(function()
        local params = OverlapParams.new()
        pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end)
        pcall(function() params.FilterDescendantsInstances = { char } end)
        local nearby = workspace:GetPartBoundsInRadius(root.Position, 40, params)
        for _, part in ipairs(nearby or {}) do
            if (part:IsA("Seat") or part:IsA("VehicleSeat")) and part.Occupant == hum then
                found = part
                return
            end
        end
    end)
    return found
end

function Automation.VT.Resolve()
    local lp = Core.LocalPlayer
    local char = lp and lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local model, seat = nil, nil

    if hum and hum.SeatPart then
        seat = hum.SeatPart
        model = Automation.VT.ModelFromSeat(seat, char)
    end
    if not model and hum then
        local nearSeat = Automation.VT.SeatByOccupant(hum, char)
        if nearSeat then
            seat = nearSeat
            model = Automation.VT.ModelFromSeat(nearSeat, char)
        end
    end

    -- ещё не посадили, но сервер только что заспавнил нашу технику — берём именно её
    if not model then
        local cand = Automation.VT.SpawnedModel
        local fresh = cand and typeof(cand) == "Instance" and cand.Parent and (tick() - (Automation.VT.SpawnedAt or 0)) <= 20
        if fresh then
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local okPivot, pivot = pcall(function() return cand:GetPivot() end)
            if okPivot and pivot and hrp and (pivot.Position - hrp.Position).Magnitude <= 120 then
                model = cand
            end
        end
    end

    return {
        character = char,
        humanoid = hum,
        seat = seat,
        model = model,
        kind = Automation.VT.ModelKind(model),
        parts = model and Automation.VT.Parts(model) or {},
    }
end

function Automation.VT.Where(info)
    if info and info.model and info.model.Parent then
        local ok, pivot = pcall(function() return info.model:GetPivot() end)
        if ok and pivot then return pivot.Position end
    end
    local lp = Core.LocalPlayer
    local char = lp and lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then return hrp.Position end
    return nil
end

-- сам телепорт: одна зафиксированная модель, якорь, проверка прибытия и ретраи
function Automation.VT.Jump(cf, opts)
    opts = opts or {}
    local cfg = Automation.VT.Cfg()
    local attempts = math.clamp(math.floor(tonumber(opts.Attempts) or cfg.TpAttempts or 4), 1, 10)
    local lp = Core.LocalPlayer
    local info = Automation.VT.Resolve()
    if not info.character then return false, "character not found" end

    local target, surface = Automation.VT.Solve(cf, info.model, info.kind)
    local tolerance = 15
    local arrived = false
    local lastErr = "teleport did not happen"
    local mode = info.model and "vehicle" or "character"
    local kind = info.kind

    Automation.VT.Busy = true
    local okRun, runErr = pcall(function()
        for attempt = 1, attempts do
            if not info.character.Parent then
                lastErr = "character disappeared"
                return
            end

            local frozen = nil
            if info.model and info.model.Parent then
                for _, part in ipairs(info.parts) do
                    pcall(function() part:SetNetworkOwner(lp) end)
                end
                Automation.VT.ZeroVelocity(info.parts)
                if cfg.TpAnchor then frozen = Automation.VT.Freeze(info.parts) end
            else
                local hrp = info.character:FindFirstChild("HumanoidRootPart")
                if hrp then pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end) end
            end

            local moved = false
            if info.model and info.model.Parent then
                moved = pcall(function() info.model:PivotTo(target) end)
            end
            if not moved then
                local hrp = info.character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    moved = pcall(function() hrp.CFrame = target end)
                    mode = "character"
                end
            end

            Automation.VT.ZeroVelocity(info.parts)
            task.wait(0.1)
            Automation.VT.Unfreeze(frozen)
            Automation.VT.ZeroVelocity(info.parts)
            task.wait(0.15)

            local nowPos = Automation.VT.Where(info)
            local dist = nowPos and (nowPos - target.Position).Magnitude or nil
            print(string.format("[VEH-TP] attempt %d/%d: %s, %s, distance %.1f studs",
                attempt, attempts, moved and "moved" or "NOT moved", mode .. "/" .. kind, dist or -1))

            if dist and dist <= tolerance then
                arrived = true
                return
            end
            if dist then
                lastErr = string.format("did not arrive: %.1f studs left", dist)
            else
                lastErr = moved and "target disappeared after the teleport" or "teleport did not happen"
            end
            task.wait(0.2)
        end
    end)
    Automation.VT.Busy = false

    if not okRun then return false, "teleport error: " .. tostring(runErr) end
    local extra = { kind = kind, mode = mode, surface = surface, target = target }
    if arrived then return true, nil, extra end
    return false, lastErr, extra
end

-- что за техника и куда она встанет — для кнопки диагностики
function Automation.VT.Diagnose()
    local info = Automation.VT.Resolve()
    local metrics = Automation.VT.Metrics(info.model)
    local pos = info.model and metrics.pivot and metrics.pivot.Position or Automation.VT.Where(info)
    local surface = pos and Automation.VT.SurfaceAt(pos, info.model) or nil
    print(string.format("[VEH-TP] diagnose: model=%s kind=%s bottom=%.1f size=(%.1f %.1f %.1f) surface=%s",
        info.model and info.model:GetFullName() or "none (character)",
        info.kind,
        metrics.bottom or 0,
        metrics.size.X, metrics.size.Y, metrics.size.Z,
        surface and string.format("%s %.1f", tostring(surface.material), surface.y) or "none"))
    return info.kind, metrics, surface
end

-- совместимость со старым кодом: возвращает модель техники, в которой мы сидим
function Automation.GetRidingVehicle()
    local info = Automation.VT.Resolve()
    return info.model
end

-- [ v49 ] Телепорт на сохранённые координаты
function Automation.TeleportToCoords(s, attempts)
    local cf = Automation.ParseCFrameString(s)
    if not cf then return false, "could not parse the coordinates" end
    return Automation.VT.Jump(cf, { Attempts = attempts })
end

-- [ v80 ] TELEPORT SPOTS: named CFrame spots, each one with its own key (any game)
Automation.TpBindButtons = {}

Automation.TpPoints = function()
    if type(Config.Teleport) ~= "table" then Config.Teleport = { Points = {} } end
    if type(Config.Teleport.Points) ~= "table" then Config.Teleport.Points = {} end
    return Config.Teleport.Points
end

Automation.TpFormatCFrame = function(cf)
    if typeof(cf) ~= "CFrame" then return "" end
    return string.format("CFrame.new(%.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f, %.3f)", cf:GetComponents())
end

-- where the player is right now: the vehicle pivot while riding, otherwise the HRP
Automation.TpGrabCFrame = function()
    local veh = Automation.GetRidingVehicle and Automation.GetRidingVehicle()
    if veh then
        local ok, pivot = pcall(function() return veh:GetPivot() end)
        if ok and pivot then return Automation.TpFormatCFrame(pivot) end
    end
    local lp = game:GetService("Players").LocalPlayer
    local hrp = lp and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
    if hrp then return Automation.TpFormatCFrame(hrp.CFrame) end
    return nil
end

-- one key fires one thing: take that key away from the other spots
Automation.TpClearKey = function(keyCode, keepIndex)
    local name = typeof(keyCode) == "EnumItem" and keyCode.Name or tostring(keyCode or "")
    if name == "" or name == "None" then return end
    local cleared = false
    for i, pt in ipairs(Automation.TpPoints()) do
        if i ~= keepIndex and type(pt) == "table" and pt.Key == name then
            pt.Key = nil
            cleared = true
        end
    end
    if cleared then Automation.TpRefreshBinds() end
end

Automation.TpAssignBind = function(index, keyCode)
    if typeof(keyCode) ~= "EnumItem" then return false end
    local pt = Automation.TpPoints()[index]
    if type(pt) ~= "table" then return false end
    Automation.TpClearKey(keyCode, index)
    -- a module bind on the same key would fire as well: the spot wins, the module bind is dropped
    if State.ModuleBinds then
        for modName, bind in pairs(State.ModuleBinds) do
            local bk = (type(bind) == "table") and bind.Key or bind
            local code = Internal.CoerceKeyBind and Internal.CoerceKeyBind(bk, nil)
            if code == keyCode then
                State.ModuleBinds[modName] = nil
                if Config.ModuleBinds then Config.ModuleBinds[modName] = nil end
            end
        end
    end
    pt.Key = keyCode.Name
    Automation.TpRefreshBinds()
    return true
end

Automation.TpClearBind = function(index)
    local pt = Automation.TpPoints()[index]
    if type(pt) ~= "table" then return end
    pt.Key = nil
    Automation.TpRefreshBinds()
end

Automation.TpRefreshBinds = function()
    for idx, btn in pairs(Automation.TpBindButtons or {}) do
        if btn.Parent then
            local pt = Automation.TpPoints()[idx]
            btn.Text = (type(pt) == "table" and pt.Key) or "NONE"
        else
            Automation.TpBindButtons[idx] = nil
        end
    end
end

Automation.TpGo = function(index)
    local pt = Automation.TpPoints()[index]
    if type(pt) ~= "table" then return false, "spot not found" end
    if (pt.CFrame or "") == "" then return false, "coordinates are empty" end
    if not Automation.ParseCFrameString(pt.CFrame) then return false, "could not parse the coordinates" end
    local label = tostring(pt.Name or ("Point " .. index))
    task.spawn(function()
        local ok, err = Automation.TeleportToCoords(pt.CFrame, 4)
        if ok then
            if _G.Log then pcall(_G.Log, "TP: " .. label, Color3.fromRGB(0, 255, 150)) end
        else
            if _G.Log then pcall(_G.Log, "TP " .. label .. ": FAILED - " .. tostring(err), Color3.fromRGB(255, 80, 80)) end
        end
    end)
    return true
end

-- called from the global InputBegan handler, so the menu can stay closed
Automation.TpHandleKey = function(keyCode)
    if typeof(keyCode) ~= "EnumItem" then return false end
    local name = keyCode.Name
    if name == "" or name == "Unknown" then return false end
    for i, pt in ipairs(Automation.TpPoints()) do
        if type(pt) == "table" and pt.Key == name then
            Automation.TpGo(i)
            return true
        end
    end
    return false
end

-- [ v49 ] Спавн -> ждём посадку в технику -> TP -> (цикл ждёт смерть и повторяет)
function Automation.TpAfterSpawnRoutine()
    local try = (Automation._tpSeq or 0) + 1
    Automation._tpSeq = try
    local delaySec = tonumber(Config.VehiclesFarm.TpDelay) or 1.0

    task.spawn(function()
        task.wait(delaySec)
        if Automation._tpSeq ~= try then return end
        if not (Config.VehiclesFarm.Enabled and Config.VehiclesFarm.TpAfterSpawn) then return end
        if (Config.VehiclesFarm.TpCoords or "") == "" then return end

        -- ждём, пока игра посадит нас в заспавненную технику (до 3 с)
        local waited = 0
        while waited < 3 and not Automation.IsSeatedInVehicle() do
            if Automation._tpSeq ~= try then return end
            task.wait(0.2)
            waited = waited + 0.2
        end
        if Automation._tpSeq ~= try then return end
        if waited >= 3 and not Automation.IsSeatedInVehicle() then
            print("[TP-AFTER-SPAWN] seat not confirmed within 3 s - teleporting the character only")
        end

        -- не начинаем второй TP поверх первого: два PivotTo подряд дают улёт
        local busyWait = 0
        while Automation.VT.Busy and busyWait < 5 do
            if Automation._tpSeq ~= try then return end
            task.wait(0.2)
            busyWait = busyWait + 0.2
        end
        if Automation._tpSeq ~= try then return end

        local ok, err, extra = Automation.TeleportToCoords(Config.VehiclesFarm.TpCoords)
        if ok then
            print(string.format("[TP-AFTER-SPAWN] teleport done (delay %.1f + wait %.1f s, %s/%s)",
                delaySec, waited, extra and extra.mode or "?", extra and extra.kind or "?"))
            if _G.Log then
                pcall(_G.Log, "TP: teleport done (" .. tostring(extra and extra.kind or "") .. ")",
                    Color3.fromRGB(0, 255, 150))
            end
        else
            print("[TP-AFTER-SPAWN] FAILED: " .. tostring(err))
            if _G.Log then pcall(_G.Log, "TP: FAILED - " .. tostring(err), Color3.fromRGB(255, 80, 80)) end
        end
    end)
end

-- [ v48 ] Цикл
function Automation.SpawnTpLoop()
    if Automation._tpLoopActive then return end
    Automation._tpLoopActive = true

    task.spawn(function()
        local Players_ = game:GetService("Players")
        local function log(msg)
            print("[TP-CYCLE] " .. tostring(msg))
            if _G.Log then pcall(_G.Log, "TP: " .. tostring(msg), Color3.fromRGB(0, 220, 190)) end
        end

        local function active()
            return Config.VehiclesFarm.Enabled and Config.VehiclesFarm.TpAfterSpawn
                and not State.Unloading and IsCurrentInstance()
        end

        log("loop started (spawn -> TP -> wait for death -> repeat)")

        while active() do
            local lp = Players_.LocalPlayer
            local char = lp and lp.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")

            -- 1) живы -> спавним (SpawnVehicle сам телепортирует
            if hum and hum.Health > 0 then
                Automation.SpawnVehicle(Config.VehiclesFarm.Vehicle)
            end

            -- 2) ждём смерть текущего персонажа
            local conn
            local died = false
            local curChar = lp and lp.Character
            local curHum = curChar and curChar:FindFirstChildOfClass("Humanoid")
            if curHum then
                pcall(function() conn = curHum.Died:Connect(function() died = true end) end)
                local deadline = tick() + 300
                while active() and not died and tick() < deadline do
                    if not curHum.Parent or (curHum.Health or 0) <= 0 then
                        died = true
                        break
                    end
                    task.wait(0.2)
                end
                if conn then pcall(function() conn:Disconnect() end) end
            else
                task.wait(1)
            end

            if not active() then break end
            log("death detected -> waiting for respawn")

            -- 3) ждём новый живой персонаж
            local waited = 0
            repeat
                task.wait(0.2)
                waited = waited + 0.2
                lp = Players_.LocalPlayer
                char = lp and lp.Character
                hum = char and char:FindFirstChildOfClass("Humanoid")
            until (hum and hum.Health > 0) or waited > 20 or not active()

            task.wait(0.4)
        end

        Automation._tpLoopActive = false
        log("loop stopped")
    end)
end

function Automation.SpawnVehicle(name)
    -- [ v82 ] второй спавн во время TP уводил машину с точки: держим паузу и не спавним в полёте
    if Automation.VT and Automation.VT.Busy then
        print("[VEHICLES-FARM] spawn skipped: teleport in progress")
        return
    end
    local nowSpawn = tick()
    local lastSpawn = Automation._lastSpawnAt
    if lastSpawn and (nowSpawn - lastSpawn) < 3 then
        print("[VEHICLES-FARM] spawn skipped: 3 s cooldown")
        return
    end
    Automation._lastSpawnAt = nowSpawn
    -- [ v46 ] Сначала ПРЯМОЙ спавн через Knit MountService.SpawnMount
    if Automation.TryDirectMountSpawn(name) then
        -- [ v49 ] TP After Spawn
        if Config.VehiclesFarm.TpAfterSpawn == true and (Config.VehiclesFarm.TpCoords or "") ~= "" then
            Automation.TpAfterSpawnRoutine()
        end
        return
    end
    task.spawn(function()
        local fired = false
        local startTime = tick()

        local function safeLog(msg, color)
            if _G.Log then pcall(_G.Log, msg, color) end
        end

        -- Helper to click any GuiObject or GuiButton with Native GuiService Selection & VIM
        local function safeClick(obj)
            if not obj or typeof(obj) ~= "Instance" then return end

            -- 1. GuiService.SelectedObject + Return Key (Native Roblox UI Activation)
            pcall(function()
                local guiService = game:GetService("GuiService")
                local vim = game:GetService("VirtualInputManager")
                local targetBtn = obj:IsA("GuiButton") and obj or obj:FindFirstAncestorWhichIsA("GuiButton") or obj
                guiService.SelectedObject = targetBtn
                task.wait(0.04)
                vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
                task.wait(0.04)
                vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
                guiService.SelectedObject = nil
            end)

            -- 2. VirtualInputManager MouseClick at exact center
            if obj:IsA("GuiObject") and obj.AbsoluteSize.X > 0 and obj.AbsoluteSize.Y > 0 then
                local cx = obj.AbsolutePosition.X + obj.AbsoluteSize.X / 2
                local cy = obj.AbsolutePosition.Y + obj.AbsoluteSize.Y / 2

                pcall(function()
                    print(string.format("[SPAWN-CLICK] VIM MouseClick at (%d, %d) on %s", cx, cy, obj:GetFullName()))
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendMouseButtonEvent(cx, cy, 0, true, game, 0)
                    task.wait(0.05)
                    vim:SendMouseButtonEvent(cx, cy, 0, false, game, 0)
                end)
            end

            -- 3. firesignal (if supported)
            if firesignal and obj:IsA("GuiButton") then
                pcall(function() firesignal(obj.MouseButton1Down) end)
                pcall(function() firesignal(obj.MouseButton1Up) end)
                pcall(function() firesignal(obj.MouseButton1Click) end)
                pcall(function() firesignal(obj.Activated) end)
            end

            -- 4. getconnections (executor-agnostic)
            if getconnections then
                for _, evName in ipairs({ "MouseButton1Down", "MouseButton1Up", "MouseButton1Click", "Activated", "TouchTap" }) do
                    pcall(function()
                        local ok, sig = pcall(function() return obj[evName] end)
                        if ok and sig and typeof(sig) == "RBXScriptSignal" then
                            local okC, conns = pcall(getconnections, sig)
                            if okC and type(conns) == "table" then
                                for _, c in ipairs(conns) do
                                    pcall(function()
                                        if type(c) == "table" or typeof(c) == "RBXScriptConnection" or type(c) == "userdata" then
                                            if type(c.Fire) == "function" then
                                                c:Fire()
                                            elseif type(c.Function) == "function" then
                                                c.Function()
                                            end
                                        end
                                    end)
                                end
                            end
                        end
                    end)
                end
            end
        end

        safeLog("Vehicles Farm: Spawning " .. name, Color3.fromRGB(255, 255, 0))

        -- Снимок моделей workspace ДО спавна
        local preModels = {}
        pcall(function()
            for _, m in workspace:GetDescendants() do
                if m:IsA("Model") and m.Name:lower():find(name:lower(), 1, true) then
                    preModels[m] = true
                end
            end
        end)

        local function checkNewModel(timeoutSec)
            local deadline = tick() + (timeoutSec or 4)
            while tick() < deadline do
                task.wait(0.4)
                for _, m in workspace:GetDescendants() do
                    if m:IsA("Model") and m.Name:lower():find(name:lower(), 1, true) and not preModels[m] then
                        return m
                    end
                end
            end
            return nil
        end

        -- 1. АСИНХРОННЫЙ ВЫЗОВ REMOTES KNIT (без задержек)
        pcall(function()
            local knitServices = RS:FindFirstChild("Packages") and RS.Packages:FindFirstChild("Knit") and RS.Packages.Knit:FindFirstChild("Services")
            if knitServices then
                for _, service in ipairs(knitServices:GetChildren()) do
                    local sName = service.Name:lower()
                    if sName:find("mount") or sName:find("spawner") or sName:find("vehicle") or sName:find("tycoon") then
                        local reFolder = service:FindFirstChild("RE")
                        if reFolder then
                            for _, re in ipairs(reFolder:GetChildren()) do
                                if re:IsA("RemoteEvent") then
                                    pcall(function() re:FireServer(name) end)
                                    pcall(function() re:FireServer(name, "Default") end)
                                end
                            end
                        end
                    end
                end
            end
        end)

        local function isGuiVisible(gui)
            if not gui or not gui:IsA("GuiObject") then return false end
            if gui.AbsoluteSize.X <= 5 or gui.AbsoluteSize.Y <= 5 then return false end
            local curr = gui
            while curr and curr:IsA("GuiObject") do
                if not curr.Visible then return false end
                curr = curr.Parent
            end
            return true
        end

        local function isBadAncestor(v)
            local bad = false
            pcall(function()
                bad = (v:FindFirstAncestor("DroneSpawner") ~= nil)
                    or (v:FindFirstAncestor("LargeDroneSpawner") ~= nil)
                    or (v:FindFirstAncestor("GunshipSelectionInterface") ~= nil)
                    or (v:FindFirstAncestor("ProximityPrompts") ~= nil)
                    or (v:FindFirstAncestor("ProximityPrompt") ~= nil)
                    or (v:FindFirstAncestor("Prompt") ~= nil)
                    or (v.Name:lower():find("proximity") ~= nil)
            end)
            return bad
        end

        -- 2. МГНОВЕННЫЙ ГРАФИЧЕСКИЙ КЛИК ПО UI MountSpawner
        while tick() - startTime < 10 and not fired and not State.Unloading do
            local pg = Core.LocalPlayer:FindFirstChild("PlayerGui")
            if not pg then break end

            local mountSpawner = pg:FindFirstChild("MountSpawner", true)
                or pg:FindFirstChild("VehicleSpawner", true)
                or pg:FindFirstChild("Spawner", true)

            if mountSpawner and not isGuiVisible(mountSpawner) then
                pcall(function() mountSpawner.Visible = true end)
            end

            -- ШАГ 1: Выбор техники в списке UI
            local vehicleSelected = false
            local searchRoot = mountSpawner or pg
            for _, v in ipairs(searchRoot:GetDescendants()) do
                if v:IsA("GuiObject") and isGuiVisible(v) and not isBadAncestor(v) then
                    local text = ""
                    if v:IsA("TextButton") or v:IsA("TextLabel") then text = v.Text:lower() end
                    for _, desc in ipairs(v:GetDescendants()) do
                        if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                            text = text .. " " .. desc.Text:lower()
                        end
                    end

                    if text:find(name:lower(), 1, true) or v.Name:lower():find(name:lower(), 1, true) then
                        local clickTarget = v:IsA("GuiButton") and v or v:FindFirstAncestorWhichIsA("GuiButton") or v
                        print(string.format("[SPAWN-STEP 1] Selecting vehicle '%s' at %s", name, clickTarget:GetFullName()))
                        safeClick(clickTarget)
                        vehicleSelected = true
                        break
                    end
                end
            end

            if vehicleSelected then task.wait(0.3) end

            -- ШАГ 2: ПРЯМОЕ НАЖАТИЕ SpawnMountButton В MountSpawner
            local spawnBtn = nil
            if mountSpawner then
                spawnBtn = mountSpawner:FindFirstChild("SpawnMountButton", true)
                    or mountSpawner:FindFirstChild("SpawnButton", true)
                    or mountSpawner:FindFirstChild("Spawn", true)
            end

            -- Если не нашли точный SpawnMountButton
            if not spawnBtn then
                local spawnArea = 0
                for _, v in ipairs(searchRoot:GetDescendants()) do
                    if v:IsA("GuiObject") and isGuiVisible(v) and not isBadAncestor(v) then
                        local ownText = v.Name:lower()
                        if v:IsA("TextButton") or v:IsA("TextLabel") then ownText = ownText .. " " .. v.Text:lower() end
                        for _, desc in ipairs(v:GetDescendants()) do
                            if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                                ownText = ownText .. " " .. desc.Text:lower()
                            end
                        end

                        if (ownText:find("spawn") or ownText:find("спавн") or ownText:find("deploy"))
                            and not ownText:find("dock") and not ownText:find("req") then

                            local area = v.AbsoluteSize.X * v.AbsoluteSize.Y
                            if area > spawnArea then
                                spawnArea = area
                                spawnBtn = v
                            end
                        end
                    end
                end
            end

            if spawnBtn then
                local clickObj = spawnBtn:IsA("GuiButton") and spawnBtn or spawnBtn:FindFirstAncestorWhichIsA("GuiButton") or spawnBtn
                print(string.format("[SPAWN-STEP 2] Clicking SPAWN button: %s", clickObj:GetFullName()))
                safeClick(clickObj)
                safeClick(spawnBtn)
                fired = true
            end

            if not fired then task.wait(0.5) end
        end

        -- ПРОВЕРКА ФАКТА
        if fired then
            local newModel = checkNewModel(5)
            if newModel then
                Automation.VT.NoteSpawned(newModel)
                safeLog("Vehicles Farm: Spawn CONFIRMED (new model in workspace)", Color3.fromRGB(0, 255, 150))
            else
                safeLog("Vehicles Farm: click sent, waiting for the vehicle to appear...", Color3.fromRGB(255, 160, 0))
            end
        else
            safeLog("Vehicles Farm: Spawn failed (button not found in the UI)", Color3.fromRGB(255, 50, 50))
        end

        -- [ v49 ] TP After Spawn работает и при спавне через UI
        if Config.VehiclesFarm.TpAfterSpawn == true and (Config.VehiclesFarm.TpCoords or "") ~= "" then
            Automation.TpAfterSpawnRoutine()
        end
    end)
end

function Automation.VehiclesFarmHelper()
    if tick() - (Automation.lastHelperRun or 0) < 2 then return end
    Automation.lastHelperRun = tick()

    task.spawn(function()
        local safeLog = function(msg, color)
            if _G.Log then pcall(_G.Log, msg, color) end
        end

        local targetVeh = Config.VehiclesFarm.Vehicle or "MRZR Buggy"
        safeLog("Vehicles Farm: Spawning " .. tostring(targetVeh) .. "...", Color3.fromRGB(255, 255, 0))
        print("[VEHICLES-FARM] VehiclesFarmHelper executed! Target: " .. tostring(targetVeh))

        local lp = Core.LocalPlayer
        local terminal, promptObj, foundCount = Automation.pickCarTerminal(lp)

        if terminal then
            local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                -- [ v82 ] сидя в технике дёргать HRP нельзя: сварка сиденья утаскивает машину
                if Automation.IsSeatedInVehicle() then
                    print("[VEHICLES-FARM] seated in a vehicle - skipping the warp to the terminal")
                else
                    safeLog("Teleporting to Vehicle Spawner!", Color3.fromRGB(0, 255, 0))
                    print("[VEHICLES-FARM] Teleporting to terminal: " .. terminal:GetFullName())
                    hrp.CFrame = terminal.CFrame * CFrame.new(0, 0, 3) + Vector3.new(0, 2, 0)
                end
                task.wait(0.3)

                if promptObj and fireproximityprompt then
                    pcall(function() fireproximityprompt(promptObj) end)
                end

                if firetouchinterest then
                    pcall(function()
                        firetouchinterest(hrp, terminal, 0)
                        task.wait(0.05)
                        firetouchinterest(hrp, terminal, 1)
                    end)
                end

                task.wait(0.5)
                Automation.SpawnVehicle(targetVeh)
            end
        else
            safeLog("Vehicles Farm: own spawner not found, trying a direct spawn...", Color3.fromRGB(255, 160, 0))
            print("[VEHICLES-FARM] No terminal found, running direct SpawnVehicle...")
            Automation.SpawnVehicle(targetVeh)
        end
    end)
end

function Automation.VehiclesFarmLoop()
    task.spawn(function()
        local safeLog = function(msg, color)
            if _G.Log then pcall(_G.Log, msg, color) end
        end

        safeLog("Vehicles Farm Loop: Active", Color3.fromRGB(0, 255, 150))
        print("[VEHICLES-FARM] Loop started")
        while Config.VehiclesFarm.Enabled and not State.Unloading and IsCurrentInstance() do
            if Config.VehiclesFarm.TpAfterSpawn == true then
                -- [ v48 ] в режиме TP-цикла спавном управляет Automation.SpawnTpLoop
                task.wait(1)
            else
                Automation.VehiclesFarmHelper()
                task.wait(6)
            end
        end
        safeLog("Vehicles Farm Loop: Stopped", Color3.fromRGB(255, 50, 50))
        print("[VEHICLES-FARM] Loop stopped")
    end)
end

