-- [ v55 ] Self-healing session state
function Automation.WarTycoonAutoBuildState()
    Automation._wtDonePads = Automation._wtDonePads or {}
    Automation._wtPadFails = Automation._wtPadFails or {}
    Automation._wtStats = Automation._wtStats or {
        purchases = 0, rebirths = 0, rollbacks = 0, spent = 0, errors = 0, startedAt = tick(),
    }
    return Automation._wtStats
end

function Automation.WarTycoonAutoBuildLimitReached()
    local cfg = Config.WarTycoonBuild
    local st = Automation._wtStats
    local maxSpend = tonumber(cfg.MaxSpend) or 0
    if maxSpend > 0 and st.spent >= maxSpend then
        return "spend limit reached ($" .. Automation.WarTycoonAutoBuildFormatMoney(maxSpend) .. ")"
    end
    local maxRb = tonumber(cfg.StopAfterRebirths) or 0
    if maxRb > 0 and st.rebirths >= maxRb then
        return "rebirth limit reached (" .. tostring(maxRb) .. ")"
    end
    return nil
end

function Automation.WarTycoonAutoBuildReport(reason)
    local st = Automation._wtStats
    local dur = math.max(0, tick() - (st.startedAt or tick()))
    local perHour = 0
    if dur > 1 then perHour = math.floor(st.purchases / (dur / 3600)) end
    local lines = {
        "[Auto Build] session report",
        string.format("  reason      : %s", tostring(reason or "stopped")),
        string.format("  duration    : %d min %d sec", math.floor(dur / 60), math.floor(dur % 60)),
        string.format("  purchases   : %d", st.purchases),
        string.format("  rebirths    : %d", st.rebirths),
        string.format("  spent       : $%s", Automation.WarTycoonAutoBuildFormatMoney(st.spent)),
        string.format("  TP rollbacks: %d", st.rollbacks),
        string.format("  errors      : %d", st.errors),
        string.format("  purchases/h : %d", perHour),
        string.format("  priority    : %s", tostring(Config.WarTycoonBuild.Priority)),
    }
    for _, line in ipairs(lines) do print("[AUTO-BUILD]" .. line) end
    if Config.WarTycoonBuild.ReportFile ~= false and writefile and makefolder then
        pcall(function()
            if type(isfolder) == "function" then
                if not isfolder("Overmind") then makefolder("Overmind") end
                if not isfolder("Overmind/logs") then makefolder("Overmind/logs") end
            end
            local name = "Overmind/logs/autobuild_" .. os.date("%Y-%m-%d_%H-%M-%S") .. ".txt"
            writefile(name, table.concat(lines, "\n") .. "\n")
            Automation.WarTycoonAutoBuildLog("report saved: " .. name, Color3.fromRGB(0, 255, 150))
        end)
    end
    return table.concat(lines, "\n")
end

-- Own base (plot)
function Automation.WarTycoonAutoBuildFindBase()
    local lp = Core.LocalPlayer
    if not lp then return nil end
    local lpName = lp.Name
    local lpId = tostring(lp.UserId)
    local teamName = lp.Team and lp.Team.Name or nil

    -- 2 = explicitly me, 1 = my team (shared plots), 0 = not mine. Exact owner
    -- wins, so a teammate's plot can never be picked before my own.
    local function valueRank(v)
        if v == lp then return 2 end
        local s = tostring(v)
        if s == lpId or s:lower() == lpName:lower() then return 2 end
        if teamName and s:lower() == teamName:lower() then return 1 end
        return 0
    end

    local function ownerRank(obj)
        local best = 0
        for _, attrName in ipairs({ "Owner", "owner", "OwnerId", "ownerId", "OwnerUserId", "UserId", "userId", "Player" }) do
            local a = obj:GetAttribute(attrName)
            if a ~= nil then
                local rank = valueRank(a)
                if rank > best then best = rank end
            end
        end
        for _, childName in ipairs({ "Owner", "owner", "OwnerValue", "Player", "TycoonOwner", "OwnerUserId" }) do
            local v = obj:FindFirstChild(childName)
            if v then
                local rank = 0
                if v:IsA("ObjectValue") then
                    if v.Value == lp or v.Value == lp.Character then
                        rank = 2
                    else
                        rank = valueRank(v.Value)
                    end
                elseif v:IsA("StringValue") then
                    rank = valueRank(v.Value)
                elseif v:IsA("IntValue") or v:IsA("NumberValue") then
                    if tostring(v.Value) == lpId then rank = 2 end
                end
                if rank > best then best = rank end
            end
        end
        return best
    end

    local function positionOf(obj)
        if obj:IsA("Model") then
            local ok, pos = pcall(function() return obj:GetPivot().Position end)
            if ok and pos then return pos end
        elseif obj:IsA("BasePart") then
            return obj.Position
        elseif obj:IsA("Folder") then
            local ok, part = pcall(function() return obj:FindFirstChildWhichIsA("BasePart", true) end)
            if ok and part then return part.Position end
        end
        return nil
    end

    local origin = Automation._wtHomePos
    if not origin then
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then origin = hrp.Position end
    end
    local function distance(obj)
        if not origin then return 0 end
        local pos = positionOf(obj)
        if not pos then return math.huge end
        return (pos - origin).Magnitude
    end
    local function consider(best, obj)
        local rank = ownerRank(obj)
        if rank <= 0 then return best end
        local dist = distance(obj)
        if not best or rank > best.rank or (rank == best.rank and dist < best.dist) then
            return { obj = obj, rank = rank, dist = dist }
        end
        return best
    end

    local function hasOwnedAncestor(obj)
        local p = obj.Parent
        while p and p ~= workspace do
            if (p:IsA("Model") or p:IsA("Folder")) and ownerRank(p) > 0 then
                return true
            end
            p = p.Parent
        end
        return false
    end

    local containers = { "Tycoons", "Bases", "Plots", "Tycoon", "Base", "PlayerBases" }
    local best
    for _, contName in ipairs(containers) do
        local cont = workspace:FindFirstChild(contName)
        if not cont then cont = workspace:FindFirstChild(contName, true) end
        if cont then
            for _, child in ipairs(cont:GetChildren()) do
                if child:IsA("Model") or child:IsA("Folder") then
                    best = consider(best, child)
                end
            end
        end
    end
    if best then return best.obj end

    -- Shallow fallback only: a purchased building nested two levels inside a plot
    -- has owner values too, and the old fallback could return that building.
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("Folder")) and obj ~= lp.Character then
            local depth, p = 0, obj.Parent
            while p and p ~= workspace and depth < 4 do
                depth = depth + 1
                p = p.Parent
            end
            -- depth 1 = plot directly under a container; depth 2 would be a
            -- purchased building inside that plot, which is not a base.
            if p == workspace and depth <= 1 and #obj:GetChildren() >= 3
                and not hasOwnedAncestor(obj) then
                best = consider(best, obj)
            end
        end
    end
    return best and best.obj or nil
end

function Automation.WarTycoonAutoBuildBase(forceRefresh)
    local now = tick()
    local b = Automation._wtBase
    if b and b.Parent and not forceRefresh and (now - (Automation._wtBaseAt or 0)) < 6 then
        return b
    end
    local prev = b
    b = Automation.WarTycoonAutoBuildFindBase()
    Automation._wtBase = b
    Automation._wtBaseAt = now
    if b ~= prev then
        -- [ v90 ] a new/removed plot invalidates every cached pad and its cooldown
        Automation._wtPads = nil
        Automation._wtPadsBase = nil
        Automation._wtDonePads = {}
        Automation._wtPadFails = {}
        Automation._wtSaveSince = nil
        Automation._wtSaveKey = nil
        Automation._wtPadsSeen = false
    end
    return b
end

-- [ v87 ] Robux/донат-офферы нельзя покупать автоматически, даже если на кнопке
-- висит ценник. Проверяем имя, подпись и текст SurfaceGui/BillboardGui.
Automation.WarTycoonAutoBuildRobuxWords = {
    "robux", "roblox", "rbx", "donat", "tip jar",
    "gamepass", "game pass", "devproduct", "dev product", "developer product",
    "premium", "membership", "subscribe", "subscription", "gift",
    "battle pass", "season pass", "cash pack", "money pack", "coin pack",
    "gem pack", "support us", "support the game", "auto rebirth",
    "auto collect", "auto farm", "2x cash", "double cash", "2x",
}

function Automation.WarTycoonAutoBuildIsRobux(text)
    local h = string.lower(tostring(text or ""))
    if h == "" then return false end
    for _, w in ipairs(Automation.WarTycoonAutoBuildRobuxWords) do
        if h:find(w, 1, true) then return true end
    end
    -- Frontier checks for short words: "Viper"/"multiple"/"Production" must not match.
    if h:find("%f[%a]r%$") then return true end
    if h:find("%f[%a]vip%f[%A]") then return true end
    if h:find("%f[%a]tips?%f[%A]") then return true end
    if h:find("%f[%a]products?%f[%A]") then return true end
    if h:find("%f[%a]gifts?%f[%A]") then return true end
    if h:find("%f[%a]premium%f[%A]") then return true end
    return false
end

Automation.WarTycoonAutoBuildProductAttrs = {
    "ProductId", "productId", "GamePassId", "gamePassId",
    "DeveloperProductId", "developerProductId",
    "RobuxPrice", "robuxPrice", "PriceInRobux", "priceInRobux",
}

-- A product/gamepass id on the pad is the strongest sign of a Robux offer:
-- such pads often show only a bare number instead of "R$".
function Automation.WarTycoonAutoBuildHasProductSignal(scope)
    if not scope then return false end
    local function check(inst)
        if not inst then return false end
        for _, name in ipairs(Automation.WarTycoonAutoBuildProductAttrs) do
            if inst:GetAttribute(name) ~= nil then return true end
        end
        local n = string.lower(inst.Name)
        if n:find("productid", 1, true) or n:find("gamepassid", 1, true)
            or n:find("passid", 1, true) or n:find("devproduct", 1, true)
            or n:find("developerproduct", 1, true) or n:find("robuxprice", 1, true) then
            if inst:IsA("ValueBase") then
                local v = tonumber(inst.Value)
                return v ~= nil and v > 0
            end
            return true
        end
        return false
    end
    if check(scope) then return true end
    for _, d in ipairs(scope:GetDescendants()) do
        if check(d) then return true end
    end
    return false
end

function Automation.WarTycoonAutoBuildParseAmount(text)
    local s = tostring(text or ""):gsub("%s", ""):gsub(",", "")
    if s == "" then return nil end
    s = s:gsub("%$", "")
    local mult = 1
    local suffix = string.lower(s:sub(-1))
    if suffix == "k" then mult = 1e3; s = s:sub(1, -2)
    elseif suffix == "m" then mult = 1e6; s = s:sub(1, -2)
    elseif suffix == "b" then mult = 1e9; s = s:sub(1, -2)
    end
    local n = tonumber(s)
    if n and n >= 0 then return n * mult end
    return nil
end

-- returns price, isRobuxOffer
local function wtParsePrice(text)
    local raw = tostring(text or "")
    if raw == "" then return nil, false end
    if Automation.WarTycoonAutoBuildIsRobux(raw) then return nil, true end
    local lowRaw = string.lower(raw)
    -- Frontier: "Freedom" is not a free pad. Only the standalone word FREE.
    if lowRaw:find("%f[%a]free%f[%A]") then return 0, false end
    -- "INCOME $2,500" / "$500/s" -- это не цена, иначе максимум выберет доход
    if not (lowRaw:find("price", 1, true) or lowRaw:find("cost", 1, true))
        and (lowRaw:find("income", 1, true) or lowRaw:find("profit", 1, true)
            or lowRaw:find("yield", 1, true) or lowRaw:find("per second", 1, true)
            or lowRaw:find("per sec", 1, true) or lowRaw:find("/s", 1, true)
            or lowRaw:find("balance", 1, true) or lowRaw:find("total", 1, true)
            or lowRaw:find("earned", 1, true) or lowRaw:find("collected", 1, true)) then
        return nil, false
    end
    local compact = raw:gsub("%s", "")
    local low = string.lower(compact)
    local amount = compact:match("%$([%d][%d,%.]*[KkMmBb]?)")
    if not amount and (low:find("price", 1, true) or low:find("cost", 1, true)
        or low:find("cash", 1, true) or low:find("money", 1, true)) then
        amount = compact:match("([%d][%d,%.]*[KkMmBb]?)")
    end
    if amount then
        local n = Automation.WarTycoonAutoBuildParseAmount(amount)
        if n then return n, false end
    end
    -- A bare number is ambiguous (it may be a Robux product price), so it is
    -- deliberately not treated as a cash price anymore.
    return nil, false
end

-- 2 = явный ценник (Price/Cost), 1 = просто "$...", 0 = запасной вариант
local function wtPriceRank(text)
    local s = tostring(text or "")
    local low = string.lower(s)
    if low:find("price", 1, true) or low:find("cost", 1, true) then return 2 end
    if s:find("$", 1, true) then return 1 end
    return 0
end

-- Pad label and price (GUI / Value objects / attributes)
function Automation.WarTycoonAutoBuildPadInfo(scope)
    local entries = {}
    local function add(text, rank)
        local t = tostring(text or ""):match("^%s*(.-)%s*$") or ""
        if t == "" then return end
        entries[#entries + 1] = { text = t, rank = tonumber(rank) or 0 }
    end
    local function guiUsable(inst)
        local p = inst
        while p and p ~= scope do
            if p:IsA("SurfaceGui") or p:IsA("BillboardGui") then
                local ok, enabled = pcall(function() return p.Enabled end)
                if ok and enabled == false then return false end
            end
            if p:IsA("GuiObject") then
                local ok, visible = pcall(function() return p.Visible end)
                if ok and visible == false then return false end
            end
            p = p.Parent
        end
        return true
    end

    if scope then
        if scope:IsA("ProximityPrompt") then
            if scope.Enabled ~= false then
                add(scope.ActionText, 0)
                add(scope.ObjectText, wtPriceRank(scope.ObjectText))
            end
        end
        for _, d in ipairs(scope:GetDescendants()) do
            if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                if guiUsable(d) then add(d.Text, wtPriceRank(d.Text)) end
            elseif d:IsA("ProximityPrompt") then
                if d.Enabled ~= false then
                    add(d.ActionText, 0)
                    add(d.ObjectText, wtPriceRank(d.ObjectText))
                end
            elseif d:IsA("StringValue") or d:IsA("IntValue") or d:IsA("NumberValue") then
                local n = string.lower(d.Name)
                if n:find("price", 1, true) or n:find("cost", 1, true) then
                    add(d.Value, 3)
                end
            end
        end
        for _, attrName in ipairs({ "Price", "Cost", "price", "cost" }) do
            local a = scope:GetAttribute(attrName)
            if a ~= nil then add(a, 3) end
        end
    end

    local label, best, bestRank, weak, robux = nil, nil, 0, nil, false
    local texts = {}
    local generic = false
    for _, e in ipairs(entries) do
        texts[#texts + 1] = e.text
        if Automation.WarTycoonAutoBuildIsRobux(e.text) then robux = true end
        local n, isRobux = wtParsePrice(e.text)
        if isRobux then robux = true end
        if n ~= nil then
            if e.rank > 0 then
                if e.rank > bestRank then
                    bestRank, best = e.rank, n
                elseif e.rank == bestRank then
                    if e.rank == 1 then
                        if n < best then best = n end
                    elseif n > best then
                        best = n
                    end
                end
            elseif not weak or n > weak then
                weak = n
            end
        elseif e.rank == 0 and #e.text <= 60 and not string.match(e.text, "^%d") then
            local low = string.lower(e.text)
            if not low:find("sold", 1, true) and not low:find("owned", 1, true)
                and not low:find("bought", 1, true) and not low:find("income", 1, true)
                and not low:find("profit", 1, true) and not low:find("total", 1, true)
                and not low:find("balance", 1, true) then
                -- "Buy" / "Open" / "Press" are prompt instructions, not the pad
                -- name; keep the longest descriptive label instead (e.g. Oil
                -- Extractor 2) so priority and diagnostics stay readable.
                local shortAction = #low <= 12 and (low:find("buy", 1, true)
                    or low:find("purchase", 1, true) or low:find("open", 1, true)
                    or low:find("press", 1, true) or low:find("hold", 1, true)
                    or low:find("use", 1, true) or low:find("click", 1, true))
                if not shortAction then
                    if not label or #e.text > #label then label = e.text end
                else
                    generic = true
                end
            end
        end
    end
    if not label and generic then
        for _, e in ipairs(entries) do
            if e.rank == 0 and #e.text <= 12 then label = e.text; break end
        end
    end
    return label, best or weak, robux, table.concat(texts, " ")
end

function Automation.WarTycoonAutoBuildIsFlatDisc(part)
    if not part or not part:IsA("BasePart") then return false end
    local s = part.Size
    if s.Y > 2.5 then return false end
    if math.abs(s.X - s.Z) > 4 then return false end
    return math.max(s.X, s.Z) >= 4
end

function Automation.WarTycoonAutoBuildHasClick(part)
    if not part then return false end
    local function check(obj)
        if not obj then return false end
        local ok, found = pcall(function() return obj:FindFirstChildOfClass("ClickDetector") end)
        if not ok or not found then return false end
        local distance = tonumber(found.MaxActivationDistance)
        return distance == nil or distance > 0
    end
    return check(part) or (part.Parent and check(part.Parent)) or false
end

function Automation.WarTycoonAutoBuildHasPrompt(part)
    if not part then return false end
    local function check(obj)
        if not obj then return false end
        local ok, found = pcall(function() return obj:FindFirstChildOfClass("ProximityPrompt") end)
        if not ok or not found then return false end
        if found.Enabled == false then return false end
        local distance = tonumber(found.MaxActivationDistance)
        return distance == nil or distance > 0
    end
    return check(part) or (part.Parent and check(part.Parent)) or false
end

-- A sign must be enabled and contain a visible text/image element. Disabled or
-- fully hidden purchase screens are exactly what used to look like a pad that
-- "was here before".
function Automation.WarTycoonAutoBuildHasVisibleSign(part, model)
    local roots = { part }
    if model and model ~= part then roots[#roots + 1] = model end
    for _, root in ipairs(roots) do            if root then
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
                    local enabled = true
                    pcall(function() enabled = d.Enabled ~= false end)
                    if enabled then
                        for _, t in ipairs(d:GetDescendants()) do
                            if t:IsA("TextLabel") or t:IsA("TextButton")
                                or t:IsA("ImageLabel") or t:IsA("ImageButton") then
                                local visible = true
                                pcall(function() visible = t.Visible ~= false end)
                                if visible then return true end
                            end
                        end
                    end
                end
            end
        end
    end
    return false
end

Automation.WarTycoonAutoBuildBuyWords = {
    "buy", "purchase", "unlock", "upgrade", "provider",
}
Automation.WarTycoonAutoBuildWeakPadWords = {
    "button", "pad", "circle", "plate", "sign", "platform",
}
Automation.WarTycoonAutoBuildDisplayWords = {
    "total cash", "balance", "income", "profit", "earnings", "per second",
    "per sec", "/s",    "stats", "earned", "collected", "cash to collect",
}
Automation.WarTycoonAutoBuildDeadPatterns = {
    "%f[%a]sold%f[%A]", "%f[%a]owned%f[%A]", "%f[%a]bought%f[%A]",
    "%f[%a]purchased%f[%A]", "%f[%a]claimed%f[%A]", "%f[%a]locked%f[%A]",
    "maxed out", "max level", "%f[%a]complete%f[%A]", "%f[%a]completed%f[%A]",
    "unavailable", "coming soon", "%f[%a]max%f[%A]", "%f[%a]maxed%f[%A]",
}

function Automation.WarTycoonAutoBuildHasWords(text, words)
    local h = string.lower(tostring(text or ""))
    for _, w in ipairs(words) do
        if h:find(w, 1, true) then return true end
    end
    return false
end

function Automation.WarTycoonAutoBuildHasDeadHint(text)
    local h = string.lower(tostring(text or ""))
    if h == "" then return false end
    for _, pattern in ipairs(Automation.WarTycoonAutoBuildDeadPatterns) do
        if h:find(pattern) then return true end
    end
    return false
end

function Automation.WarTycoonAutoBuildHasDisplayHint(text)
    return Automation.WarTycoonAutoBuildHasWords(text, Automation.WarTycoonAutoBuildDisplayWords)
end

-- A bare number (no $ / cash / money / FREE) can be a Robux product price, so it
-- is treated as suspicious. Level/Tier numbers are not prices.
function Automation.WarTycoonAutoBuildHasBarePrice(text)
    local s = string.lower(tostring(text or ""))
    if s == "" then return false end
    if s:find("$", 1, true) or s:find("cash", 1, true) or s:find("money", 1, true)
        or s:find("free", 1, true) then return false end
    if s:find("level", 1, true) or s:find("tier", 1, true) or s:find("stage", 1, true) then
        return false
    end
    for token in s:gmatch("%d[%d,%.]*[kmb]?") do
        local n = Automation.WarTycoonAutoBuildParseAmount(token)
        if n and n >= 20 then return true end
    end
    return false
end

function Automation.WarTycoonAutoBuildTriggerScore(part)
    if not part or not part:IsA("BasePart") then return 0 end
    local score = 0
    if Automation.WarTycoonAutoBuildIsFlatDisc(part) then score = score + 4 end
    if Automation.WarTycoonAutoBuildHasClick(part) then score = score + 3 end
    if Automation.WarTycoonAutoBuildHasPrompt(part) then score = score + 2 end
    if (tonumber(part.Transparency) or 0) < 0.98 then score = score + 1 end
    return score
end

-- Pads are often a Model with a floor circle and a separate sign. Choose the
-- actual floor circle/button, never a random invisible anchor or an old sign.
function Automation.WarTycoonAutoBuildBestTrigger(obj, model, base)
    if not obj then return nil end
    local best = obj
    local bestScore = Automation.WarTycoonAutoBuildTriggerScore(obj)
    local root = model
    local maxDist = 30
    if not root or root == base then
        -- Pads can be direct children of the plot with a separate sign. Look
        -- nearby for the floor circle, but never combine prices from the base.
        root = base
        maxDist = 12
    end
    if root and root ~= obj then
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("BasePart") and d ~= obj then
                local score = Automation.WarTycoonAutoBuildTriggerScore(d)
                if score > 0 then
                    local dist = (d.Position - obj.Position).Magnitude
                    if dist <= maxDist then
                        local weighted = score - (dist * 0.02)
                        if weighted > bestScore then best, bestScore = d, weighted end
                    end
                end
            end
        end
    end
    return best
end

-- Evaluate one part. A purchase pad now requires a parsed CASH price; bare
-- numbers, Robux prices and product ids are rejected. Returns nil, reason for
-- anything that must not be teleported to.
-- [ v90 ] An occupied pad is not a purchase pad. A building that already
-- stands on it has a substantial collidable part starting at the pad top.
-- Narrow signs and high roofs are ignored.
function Automation.WarTycoonAutoBuildHasBuildingOn(pad, base)
    if not pad or not pad.Parent or not base then return false, nil end
    local top = pad.Position.Y + pad.Size.Y * 0.5
    for _, d in ipairs(base:GetDescendants()) do
        if d:IsA("BasePart") and d ~= pad and not d:IsDescendantOf(pad)
            and d.CanCollide ~= false then
            local s = d.Size
            if s.Y >= 2 and s.X >= 3 and s.Z >= 3 then
                local bottom = d.Position.Y - s.Y * 0.5
                if bottom >= top - 1 and bottom <= top + 10
                    and math.abs(d.Position.X - pad.Position.X) <= pad.Size.X * 0.5
                    and math.abs(d.Position.Z - pad.Position.Z) <= pad.Size.Z * 0.5 then
                    local n = string.lower(d.Name)
                    if not (n:find("sign", 1, true) or n:find("label", 1, true)
                        or n:find("billboard", 1, true) or n:find("text", 1, true)) then
                        return true, d
                    end
                end
            end
        end
    end
    return false, nil
end

function Automation.WarTycoonAutoBuildPadEval(obj, model, scope, info, base)
    if not obj or not obj.Parent or not obj:IsA("BasePart") then return nil, "no part" end
    if not obj:IsDescendantOf(workspace) then return nil, "not in workspace" end
    local label, price, robux, textAll = info.label, info.price, info.robux, info.texts
    local nameLow = string.lower(obj.Name)
    local modelLow = (model and model ~= base) and string.lower(model.Name) or ""
    local labelLow = string.lower(tostring(label or ""))
    local combined = nameLow .. " " .. modelLow .. " " .. labelLow .. " " .. string.lower(tostring(textAll or ""))
    robux = robux or Automation.WarTycoonAutoBuildIsRobux(combined)
        or info.product or Automation.WarTycoonAutoBuildHasProductSignal(scope or obj)
    if robux then return nil, "robux/donation" end
    if Automation.WarTycoonAutoBuildHasDeadHint(combined) then return nil, "sold/owned/locked" end
    if Automation.WarTycoonAutoBuildHasBarePrice(textAll) then
        return nil, "bare price (possible Robux)"
    end
    -- A cash pack offer ("100K Cash") is a Robux product in this game, not a
    -- base pad. Real income pads say Oil/Extractor/Bank, not just Cash.
    local cashHint = nameLow .. " " .. modelLow .. " " .. labelLow
    if cashHint:find("cash", 1, true) and not cashHint:find("collect", 1, true)
        and not cashHint:find("oil", 1, true) and not cashHint:find("extract", 1, true)
        and not cashHint:find("bank", 1, true) then
        return nil, "cash offer"
    end
    -- Cheap rejection first: most BaseParts in a plot have no cash price, and
    -- scanning their model GUI for a visible sign would be wasted work.
    if price == nil then return nil, "no cash price" end
    -- [ v90 ] Tiny round prices on an otherwise unnamed pad are the typical
    -- Robux donation button ("$5"/"$10") that survived text scraping.
    if price > 0 and price <= 10
        and Automation.WarTycoonAutoBuildCategory(nameLow .. " " .. modelLow .. " " .. labelLow) == "other" then
        return nil, "tiny price (donation?)"
    end
    -- A real base pad names the building ("Oil Extractor", "Wall", "Base").
    -- A bare "BUY"/price-only pad is the usual Robux/donation button, so it is
    -- skipped instead of being teleported to.
    if Automation.WarTycoonAutoBuildCategory(nameLow .. " " .. modelLow .. " " .. labelLow) == "other" then
        local generic = labelLow == "buy" or labelLow == "purchase"
            or labelLow == "buy now" or labelLow == "purchase now" or labelLow == "unlock"
            or labelLow == "press" or labelLow == "use"
        if generic then return nil, "generic buy button" end
    end

    local click = Automation.WarTycoonAutoBuildHasClick(obj)
    local prompt = Automation.WarTycoonAutoBuildHasPrompt(obj)
    -- Never scan the whole base for a "visible sign": only the pad's own small
    -- model, or the sign paired with this pad, may provide one.
    local visualModel = (model and model ~= base and #model:GetChildren() <= 40) and model or nil
    local visual = Automation.WarTycoonAutoBuildHasVisibleSign(obj, visualModel)
        or (scope and scope ~= obj and Automation.WarTycoonAutoBuildHasVisibleSign(scope, nil))
    local flat = Automation.WarTycoonAutoBuildIsFlatDisc(obj)
    local buyText = Automation.WarTycoonAutoBuildHasWords(combined, Automation.WarTycoonAutoBuildBuyWords)
    -- Only the pad's own part/model name can make it a display board. A normal
    -- extractor sign may also contain "Income $5/s" next to its cash price;
    -- that income label must not hide a real oil pad.
    local displayName = nameLow .. " " .. modelLow
    if Automation.WarTycoonAutoBuildHasDisplayHint(displayName) and not buyText then
        return nil, "display, not a pad"
    end
    if (tonumber(obj.Transparency) or 0) >= 0.98 and not visual then return nil, "invisible" end
    -- [ v90 ] War Tycoon is a touch tycoon: you BUY by standing on the pad.
    -- Only a flat, touchable floor with a visible cash sign is a pad; signs and
    -- disabled/ghost plates are not teleport targets anymore.
    if not flat then return nil, "not a floor pad" end
    if obj.CanTouch == false then return nil, "cannot stand on it" end
    if not visual then return nil, "no visible cash sign" end
    local trigger = obj
    return {
        label = label,
        price = price,
        robux = false,
        trigger = trigger,
        combined = combined,
        visible = visual,
        click = click,
        prompt = prompt,
        flat = flat,
    }
end

-- Pad category
function Automation.WarTycoonAutoBuildCategory(hint)
    local h = string.lower(tostring(hint or ""))
    local function has(words)
        for _, w in ipairs(words) do
            if h:find(w, 1, true) then return true end
        end
        return false
    end
    if has({ "oil", "extract", "drill", "derrick", "gas", "generator", "income", "money", "cash",
        "factory", "mine", "mining", "bank", "refinery", "trade", "trading" }) then return "money" end
    if has({ "bunker", "missile", "silo", "drone", "laboratory", "lab", "radar", "defense", "defence" }) then return "bunker" end
    if has({ "garage", "vehicle", "dock", "airport", "hangar", "tank", "boat", "plane", "helipad",
        "airforce", "airfield", "aircraft", "jet", "heli", "naval", "ship", "warship", "submarine" }) then return "yard" end
    if has({ "wall", "floor", "door", "glass", "path", "roof", "main", "hq", "second", "third", "level", "stair",
        "house", "home", "barrack", "barracks", "armory", "medbay", "medical", "hospital", "bed", "beds",
        "first", "1st", "2nd", "3rd", "4th", "office", "quarters", "storage" }) then return "house" end
    return "other"
end

Automation.WarTycoonAutoBuildPriorityOrder = {
    ["Money"] = { money = 1, house = 2, yard = 3, bunker = 4, other = 5 },
    ["House"] = { house = 1, money = 2, yard = 3, bunker = 4, other = 5 },
    ["Yard"] = { yard = 1, money = 2, house = 3, bunker = 4, other = 5 },
    ["Bunker"] = { bunker = 1, money = 2, house = 3, yard = 4, other = 5 },
    ["Cheapest"] = { money = 1, house = 1, yard = 1, bunker = 1, other = 1 },
    ["All"] = { money = 1, house = 1, yard = 1, bunker = 1, other = 1 },
}

-- Scan purchase pads inside our own base
function Automation.WarTycoonAutoBuildScanPads(base)
    local ignoreShield = Config.WarTycoonBuild.IgnoreShield ~= false
    local badHints = {
        "spawner", "spawnpad", "spawn pad", "spawnpoint", "prompt", "seat",
        "collect", "collector", "atm", "cash to collect", "rebirth", "donat", "tip jar", "tips", "support", "giver",
        "attachments", "abrams",
        "join the group", "join group", "group reward", "group pad", "group only", "group", "famas",
        "robux", "gamepass", "game pass", "premium", "daily", "reward", "spin", "wheel",
        "crate", "lucky", "offer", "bundle", "gift", "cash pack", "money pack",
        "cash shop", "robux shop", "gamepass shop", "premium shop", "donation shop",
    }
    local shieldHints = { "shield", "spawnprotect", "spawn protect", "protection" }

    local function has(hint, words)
        return Automation.WarTycoonAutoBuildHasWords(hint, words)
    end

    -- [ v90 ] Dex shows War Tycoon keeps every buyable button in one folder.
    -- Scan that folder only: no decorative floors, no built objects, no ATM.
    local buttonFolder = base:FindFirstChild("UnpurchasedButtons", true)
    if buttonFolder then
        local function targetPart(item)
            local best, bestScore
            local function consider(d)
                if not d:IsA("BasePart") then return end
                local n = string.lower(d.Name)
                local score = 0
                if n:find("collision", 1, true) then score = score + 60 end
                if n:find("button", 1, true) or n:find("pad", 1, true)
                    or n:find("touch", 1, true) or n:find("trigger", 1, true)
                    or n:find("click", 1, true) then score = score + 40 end
                if Automation.WarTycoonAutoBuildHasClick(d) then score = score + 25 end
                if Automation.WarTycoonAutoBuildHasPrompt(d) then score = score + 20 end
                if Automation.WarTycoonAutoBuildIsFlatDisc(d) then score = score + 10 end
                if n:find("sign", 1, true) or n:find("label", 1, true)
                    or n:find("gui", 1, true) then score = score - 60 end
                if d.CanTouch == false then score = score - 1000 end
                if not best or score > bestScore then best, bestScore = d, score end
            end
            if item:IsA("BasePart") then consider(item) end
            for _, d in ipairs(item:GetDescendants()) do consider(d) end
            if bestScore and bestScore < 0 then return nil end
            return best
        end

        local units, skipped = {}, {}
        for _, item in ipairs(buttonFolder:GetChildren()) do
            local target = targetPart(item)
            if target then
                local names = {}
                local p = item
                while p and p ~= buttonFolder do
                    if p.Name then names[#names + 1] = p.Name end
                    p = p.Parent
                end
                local nameText = table.concat(names, " ")
                local infoLabel, infoPrice, infoRobux, infoTexts = Automation.WarTycoonAutoBuildPadInfo(target)
                local modelLabel, modelPrice, modelRobux, modelTexts = Automation.WarTycoonAutoBuildPadInfo(item)
                local namePrice, nameRobux = wtParsePrice(nameText)
                -- War Tycoon writes the real cash price into the button name
                -- ("Buy Bunker Start - [$80,000]"); prefer it over display GUIs.
                local price = namePrice or infoPrice or modelPrice
                local robux = infoRobux or modelRobux or nameRobux
                local combined = string.lower(nameText .. " " .. tostring(infoTexts or "")
                    .. " " .. tostring(modelTexts or ""))
                local label = item.Name
                local bad = has(combined, badHints)
                local shield = ignoreShield and has(combined, shieldHints)
                local reason
                if robux or Automation.WarTycoonAutoBuildIsRobux(combined)
                    or Automation.WarTycoonAutoBuildHasProductSignal(target)
                    or Automation.WarTycoonAutoBuildHasProductSignal(item) then
                    reason = "robux/donation"
                elseif Automation.WarTycoonAutoBuildHasDeadHint(combined) then
                    reason = "sold/owned/locked"
                elseif Automation.WarTycoonAutoBuildHasBarePrice(combined) then
                    reason = "bare price (possible Robux)"
                elseif price == nil then
                    reason = "no cash price"
                elseif bad or shield then
                    reason = bad and "excluded name" or "shield"
                end
                if reason then
                    skipped[#skipped + 1] = {
                        label = label, part = target,
                        name = target:GetFullName(), reason = reason,
                    }
                else
                    local unit = {
                        model = item, part = target, anchor = target,
                        partScore = 1, scope = target, folder = true, label = label,
                        price = price, key = item,
                    }
                    unit.cat = Automation.WarTycoonAutoBuildCategory(combined .. " " .. label)
                    units[#units + 1] = unit
                end
            end
        end
        Automation._wtLastSkipped = skipped
        local order = Automation.WarTycoonAutoBuildPriorityOrder[Config.WarTycoonBuild.Priority]
            or Automation.WarTycoonAutoBuildPriorityOrder["Money"]
        table.sort(units, function(a, b)
            local oa = order[a.cat] or 9
            local ob = order[b.cat] or 9
            if oa ~= ob then return oa < ob end
            local pa = a.price or math.huge
            local pb = b.price or math.huge
            if pa ~= pb then return pa < pb end
            return tostring(a.label or "") < tostring(b.label or "")
        end)
        if Config.WarTycoonBuild.Priority == "All" then
            for i = #units, 2, -1 do
                local j = math.random(i)
                units[i], units[j] = units[j], units[i]
            end
        end
        return units
    end

    local infoCache = {}
    local singleCache = {}

    -- A model is safe to treat as one pad only when it has at most one price
    -- label. Counting labels (not flat discs) keeps a pad that has a decorative
    -- ring/plate together, while a "Purchases" model with two signs is split.
    local function singlePadModel(model)
        if not model or model == base or not model:IsDescendantOf(base) then return false end
        if #model:GetChildren() > 40 then return false end
        local cached = singleCache[model]
        if cached ~= nil then return cached end
        local priceTexts = 0
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("SurfaceGui") or d:IsA("BillboardGui") then
                local enabled = true
                pcall(function() enabled = d.Enabled ~= false end)
                if enabled then
                    for _, t in ipairs(d:GetDescendants()) do
                        if t:IsA("TextLabel") or t:IsA("TextButton") then
                            local n, isRobux = wtParsePrice(t.Text)
                            if n ~= nil or isRobux then
                                priceTexts = priceTexts + 1
                                if priceTexts > 1 then singleCache[model] = false; return false end
                            end
                        end
                    end
                end
            end
        end
        singleCache[model] = true
        return true
    end

    -- [ v90 ] War Tycoon buys on touch: only flat floor pads are candidates.
    -- Collect parts that carry a price sign so a big multi-pad model can pair
    -- every pad with its own nearest sign instead of sharing one price.
    local signParts = {}
    for _, d in ipairs(base:GetDescendants()) do
        if d:IsA("BasePart") then
            for _, g in ipairs(d:GetDescendants()) do
                if g:IsA("SurfaceGui") or g:IsA("BillboardGui") then
                    local enabled = true
                    pcall(function() enabled = g.Enabled ~= false end)
                    if enabled then
                        -- Only a sign with real visible text can carry a price;
                        -- Image-only nameplates must not steal a pad's pairing.
                        local hasText = false
                        for _, t in ipairs(g:GetDescendants()) do
                            if t:IsA("TextLabel") or t:IsA("TextButton") then
                                local visible = true
                                pcall(function() visible = t.Visible ~= false end)
                                if visible then hasText = true; break end
                            end
                        end
                        if hasText then
                            signParts[#signParts + 1] = d
                            break
                        end
                    end
                end
            end
        end
    end

    local function nearestSignInfo(obj)
        local best, bestDist = nil, nil
        for _, s in ipairs(signParts) do
            if s ~= obj and s.Parent then
                local dist = (s.Position - obj.Position).Magnitude
                if dist <= 15 and (not bestDist or dist < bestDist) then
                    local info = infoCache[s]
                    if not info then
                        local label, price, robux, texts = Automation.WarTycoonAutoBuildPadInfo(s)
                        info = {
                            label = label,
                            price = price,
                            robux = robux,
                            texts = texts,
                            product = Automation.WarTycoonAutoBuildHasProductSignal(s),
                            scope = s,
                        }
                        infoCache[s] = info
                    end
                    best, bestDist = info, dist
                end
            end
        end
        return best
    end

    -- The green plate under the Cash Collector is not a purchase pad. Without
    -- this check the ATM screen price made Auto Build stand on the collector.
    local collector = Automation.WarTycoonAutoBuildFindCollector(base)
    local function isCollectorPad(obj)
        if not collector or not collector.Parent then return false end
        if obj == collector then return true end
        return (obj.Position - collector.Position).Magnitude <= 8
    end

    -- [ v90 ] A pad model often contains a decorative floor plate and a real
    -- touch part named Collision/Pad/Button. Prefer the named touch part; the
    -- first flat part in the model used to be the wrong spot to teleport to.
    local function padPartScore(pad)
        local n = string.lower(tostring(pad.Name or ""))
        local score = 0
        if n:find("collision", 1, true) then score = score + 60 end
        if n:find("pad", 1, true) or n:find("button", 1, true)
            or n:find("touch", 1, true) or n:find("trigger", 1, true)
            or n:find("click", 1, true) then score = score + 40 end
        if Automation.WarTycoonAutoBuildHasClick(pad) then score = score + 25 end
        if Automation.WarTycoonAutoBuildHasPrompt(pad) then score = score + 20 end
        if Automation.WarTycoonAutoBuildIsFlatDisc(pad) then score = score + 10 end
        -- The real pad sits under its price sign; a decorative collision plate
        -- elsewhere in the same model is farther away and loses.
        local bestDist
        for _, s in ipairs(signParts) do
            local d = (s.Position - pad.Position).Magnitude
            if not bestDist or d < bestDist then bestDist = d end
        end
        if bestDist then score = score - math.min(bestDist, 30) end
        return score
    end

    local units, byKey, skipped, skipSeen = {}, {}, {}, {}
    for _, obj in ipairs(base:GetDescendants()) do
        if obj:IsA("BasePart") and Automation.WarTycoonAutoBuildIsFlatDisc(obj) then
            local model = obj:FindFirstAncestorOfClass("Model")
            if model and not model:IsDescendantOf(base) then model = nil end
            local scope, key = obj, obj
            if model and model ~= base and singlePadModel(model) then
                scope, key = model, model
            end
            local info = infoCache[scope]
            if not info then
                local label, price, robux, texts = Automation.WarTycoonAutoBuildPadInfo(scope)
                info = {
                    label = label,
                    price = price,
                    robux = robux,
                    texts = texts,
                    product = Automation.WarTycoonAutoBuildHasProductSignal(scope),
                    scope = scope,
                }
                infoCache[scope] = info
            end
            -- [ v90 ] A big "Purchases" model is not one pad. Pair this floor
            -- pad with its nearest visible sign; never borrow a price from a
            -- bare/Robux sign in the same model.
            if info.price == nil and not info.robux
                and not Automation.WarTycoonAutoBuildHasBarePrice(info.texts) then
                local near = nearestSignInfo(obj)
                if near then
                    info = near
                    scope = near.scope
                end
            end
            -- [ v90 ] One sign = one pad. A model can contain a decorative
            -- floor, a collision wall and the real touch pad; merging them by
            -- sign lets padPartScore pick the actual pad instead of TP-ing to
            -- every flat plate in turn.
            if scope ~= obj and not (model and scope == model and model ~= base) then
                key = scope
            end
            local eval, reason = Automation.WarTycoonAutoBuildPadEval(obj, model, scope, info, base)
            if eval and isCollectorPad(obj) then
                if not skipSeen[key] then
                    skipSeen[key] = true
                    skipped[#skipped + 1] = {
                        label = eval.label or obj.Name,
                        part = obj,
                        model = model,
                        name = (model and model:GetFullName() or obj:GetFullName()),
                        reason = "cash collector",
                    }
                end
                eval = nil
            end
            if eval then
                local occupied, blocker = Automation.WarTycoonAutoBuildHasBuildingOn(obj, base)
                if occupied then
                    if not skipSeen[key] then
                        skipSeen[key] = true
                        skipped[#skipped + 1] = {
                            label = eval.label or obj.Name,
                            part = obj,
                            model = model,
                            name = (model and model:GetFullName() or obj:GetFullName()),
                            reason = "occupied (" .. tostring(blocker and blocker.Name or "object") .. ")",
                        }
                    end
                    eval = nil
                end
            end
            if eval then
                local nameLow = string.lower(obj.Name)
                local modelLow = (model and model ~= base) and string.lower(model.Name) or ""
                local labelLow = string.lower(tostring(eval.label or ""))
                local combined = nameLow .. " " .. modelLow .. " " .. labelLow
                    .. " " .. string.lower(tostring(info.texts or ""))
                local bad = has(combined, badHints)
                local shield = ignoreShield and has(combined, shieldHints)
                if bad or shield then
                    if not skipSeen[key] then
                        skipSeen[key] = true
                        skipped[#skipped + 1] = {
                            label = eval.label or obj.Name,
                            part = obj,
                            model = model,
                            name = (model and model:GetFullName() or obj:GetFullName()),
                            reason = bad and "excluded name" or "shield",
                        }
                    end
                else
                    local unit = byKey[key]
                    if not unit then
                        unit = {
                            model = model,
                            part = eval.trigger,
                            anchor = obj,
                            partScore = padPartScore(obj),
                            scope = scope,
                            label = eval.label,
                            price = eval.price,
                            key = key,
                        }
                        unit.cat = Automation.WarTycoonAutoBuildCategory(combined)
                        byKey[key] = unit
                        units[#units + 1] = unit
                    else
                        if eval.price ~= nil then unit.price = eval.price end
                        if (not unit.label or unit.label == "") and eval.label then unit.label = eval.label end
                        local score = padPartScore(obj)
                        if score > (unit.partScore or 0) then
                            unit.part, unit.anchor, unit.partScore = obj, obj, score
                        elseif not unit.anchor or not unit.anchor.Parent then
                            unit.anchor = obj
                        end
                        unit.cat = Automation.WarTycoonAutoBuildCategory(combined)
                    end
                end
            elseif reason == "robux/donation" or reason == "sold/owned/locked"
                or reason == "invisible" or reason == "display, not a pad"
                or reason == "bare price (possible Robux)" or reason == "cash offer"
                or reason == "tiny price (donation?)" or reason == "generic buy button" then
                if not skipSeen[key] then
                    skipSeen[key] = true
                    skipped[#skipped + 1] = {
                        label = info.label or obj.Name,
                        part = obj,
                        model = model,
                        name = (model and model:GetFullName() or obj:GetFullName()),
                        reason = reason,
                    }
                end
            end
        end
    end

    Automation._wtLastSkipped = skipped

    local order = Automation.WarTycoonAutoBuildPriorityOrder[Config.WarTycoonBuild.Priority]
        or Automation.WarTycoonAutoBuildPriorityOrder["Money"]
    table.sort(units, function(a, b)
        local oa = order[a.cat] or 9
        local ob = order[b.cat] or 9
        if oa ~= ob then return oa < ob end
        local pa = a.price or math.huge
        local pb = b.price or math.huge
        if pa ~= pb then return pa < pb end
        return tostring(a.label or a.part.Name) < tostring(b.label or b.part.Name)
    end)
    if Config.WarTycoonBuild.Priority == "All" then
        for i = #units, 2, -1 do
            local j = math.random(i)
            units[i], units[j] = units[j], units[i]
        end
    end
    return units
end

function Automation.WarTycoonAutoBuildPads(base, force)
    local now = tick()
    if not force and Automation._wtPads and Automation._wtPadsBase == base
        and (now - (Automation._wtPadsAt or 0)) < 1 then
        return Automation._wtPads
    end
    local pads = Automation.WarTycoonAutoBuildScanPads(base)
    Automation._wtPads, Automation._wtPadsAt, Automation._wtPadsBase = pads, now, base
    return pads
end

-- MAIN FIX
function Automation.WarTycoonAutoBuildHover(part, base)
    local lp = Core.LocalPlayer
    local char = lp and lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false, "no living character" end
    if not part or not part.Parent or not part:IsDescendantOf(workspace) then return false, "pad is gone" end
    if base and not part:IsDescendantOf(base) then return false, "pad is not in your base" end

    local hover = tonumber(Config.WarTycoonBuild.Hover) or 2.5
    local topY = part.Position.Y + (part.Size.Y * 0.5)
    local targetPos = Vector3.new(part.Position.X, topY + hover, part.Position.Z)
    pcall(function() hum.PlatformStand = false end)
    pcall(function() hum.Sit = false end)
    pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
    local okTpWrite = pcall(function() hrp.CFrame = CFrame.new(targetPos) end)
    if not okTpWrite then return false, "teleport blocked" end

    if Config.WarTycoonBuild.VerifyTp ~= false then
        Automation.WarTycoonAutoBuildState()
        local t0 = tick()
        repeat task.wait() until tick() - t0 > 0.05
        if hrp.Parent then
            local delta = (hrp.Position - targetPos).Magnitude
            if delta > 8 then
                Automation._wtStats.rollbacks = Automation._wtStats.rollbacks + 1
                return false, string.format("rolled back (%.1f studs away)", delta)
            end
        end
    end

    if Config.WarTycoonBuild.FireTouch and type(firetouchinterest) == "function" then
        pcall(function()
            firetouchinterest(hrp, part, 0)
            task.wait(0.05)
            firetouchinterest(hrp, part, 1)
        end)
    end

    task.wait(tonumber(Config.WarTycoonBuild.Delay) or 0.35)
    if part.Parent then
        -- [ v90 ] Land a bit higher above the pad. The old 0.15 studs clipped
        -- the character into the plate and some touch purchases did not register.
        pcall(function()
            hrp.CFrame = CFrame.new(Vector3.new(part.Position.X, topY + 0.75, part.Position.Z))
        end)
    end

    -- [ v90 ] War Tycoon buys by standing on the pad. Never click GUI buttons
    -- or activate prompts here: they can belong to Robux/donation offers.
    -- Fire one touch on the landed position so a teleport that skips a physics
    -- frame still counts as standing on the pad.
    if type(firetouchinterest) == "function" and part.Parent then
        pcall(function()
            firetouchinterest(hrp, part, 0)
            task.wait(0.03)
            firetouchinterest(hrp, part, 1)
        end)
    end
    task.wait(0.2)
    return true
end

-- [ v54 ] Fallback for servers that undo teleports
function Automation.WarTycoonAutoBuildWalk(part, timeout)
    local lp = Core.LocalPlayer
    local char = lp and lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or not part or not part.Parent or hum.Health <= 0 then return false end

    local savedSpeed = hum.WalkSpeed
    local deadline = tick() + (tonumber(timeout) or 6)
    pcall(function() hum.WalkSpeed = tonumber(Config.WarTycoonBuild.WalkSpeed) or 80 end)
    while tick() < deadline and part.Parent and Config.WarTycoonBuild.Enabled
        and not State.Unloading and IsCurrentInstance() do
        if (hrp.Position - part.Position).Magnitude <= 6 then break end
        pcall(function() hum:MoveTo(part.Position) end)
        task.wait(0.2)
    end
    pcall(function() hum:MoveTo(hrp.Position) end)
    pcall(function() hum.WalkSpeed = savedSpeed end)
    return (hrp.Position - part.Position).Magnitude <= 12
end

function Automation.WarTycoonAutoBuildMoney()
    local lp = Core.LocalPlayer
    if not lp then return nil end
    for _, attrName in ipairs({ "Cash", "Money", "cash", "money", "CashValue", "MoneyValue" }) do
        local a = lp:GetAttribute(attrName)
        if type(a) == "number" then return a end
        if type(a) == "string" then
            local n = Automation.WarTycoonAutoBuildParseAmount(a)
            if n then return n end
        end
    end

    local function fromValue(v)
        if v:IsA("IntValue") or v:IsA("NumberValue") then return tonumber(v.Value) end
        -- [ v87 ] некоторые игры держат баланс строкой "$1.2M"
        if v:IsA("StringValue") then return Automation.WarTycoonAutoBuildParseAmount(v.Value) end
        return nil
    end
    local function isMoneyName(name)
        local n = string.lower(tostring(name or ""))
        return n:find("cash", 1, true) ~= nil or n:find("money", 1, true) ~= nil
            or n:find("$", 1, true) ~= nil
    end

    local containers = {}
    for _, child in ipairs(lp:GetChildren()) do
        if isMoneyName(child.Name) then
            local n = fromValue(child)
            if n then return n end
        end
        if child.Name == "leaderstats" or child:IsA("Folder") then
            containers[#containers + 1] = child
        end
    end
    for _, cont in ipairs(containers) do
        for _, v in ipairs(cont:GetChildren()) do
            if isMoneyName(v.Name) then
                local n = fromValue(v)
                if n then return n end
            elseif v:IsA("Folder") then
                for _, vv in ipairs(v:GetChildren()) do
                    if isMoneyName(vv.Name) then
                        local n = fromValue(vv)
                        if n then return n end
                    end
                end
            end
        end
    end
    return nil
end

function Automation.WarTycoonAutoBuildFindCollector(base)
    if not base or not base.Parent then return nil end
    local lp = Core.LocalPlayer
    local char = lp and lp.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local origin = hrp and hrp.Position
        or (base:IsA("Model") and base:GetPivot().Position)
        or Vector3.zero
    local bad = {
        "buy", "purchase", "unlock", "donate", "donation", "robux", "gamepass",
        "product", "vip", "premium", "pack", "bundle", "shop", "store", "rebirth",
    }
    local function score(hint)
        local h = string.lower(tostring(hint or ""))
        if h:find("collect", 1, true) or h:find("atm", 1, true) then return 3 end
        if h:find("bank", 1, true) then return 2 end
        if h:find("cash", 1, true) or h:find("money", 1, true) then return 1 end
        return nil
    end

    local best, bestScore, bestDist
    for _, obj in ipairs(base:GetDescendants()) do
        if obj:IsA("BasePart") then
            local hint = obj.Name .. " " .. (obj.Parent and obj.Parent.Name or "")
            local s = score(hint)
            if s and not Automation.WarTycoonAutoBuildHasWords(hint, bad)
                and not Automation.WarTycoonAutoBuildIsRobux(hint) then
                local scope = obj
                if obj.Parent and obj.Parent:IsA("Model") and obj.Parent ~= base
                    and #obj.Parent:GetChildren() <= 40 then
                    scope = obj.Parent
                end
                local label, price, robux, texts = Automation.WarTycoonAutoBuildPadInfo(scope)
                local combined = hint .. " " .. tostring(label or "") .. " " .. tostring(texts or "")
                if not robux and not Automation.WarTycoonAutoBuildIsRobux(combined)
                    and not Automation.WarTycoonAutoBuildHasProductSignal(scope)
                    and not Automation.WarTycoonAutoBuildHasDeadHint(combined) then
                    local usable = Automation.WarTycoonAutoBuildHasClick(obj)
                        or Automation.WarTycoonAutoBuildHasPrompt(obj)
                        or Automation.WarTycoonAutoBuildIsFlatDisc(obj)
                        or (s >= 3 and obj.CanTouch ~= false)
                    local ok = usable and (s >= 3 or (s >= 2 and price == nil))
                    if ok then
                        local dist = (obj.Position - origin).Magnitude
                        if not bestScore or s > bestScore
                            or (s == bestScore and dist < (bestDist or math.huge)) then
                            best, bestScore, bestDist = obj, s, dist
                        end
                    end
                end
            end
        end
    end
    return best
end

function Automation.WarTycoonAutoBuildClickButton(btn)
    if not btn then return false end
    local fired = false
    pcall(function()
        if type(getconnections) == "function" then
            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do
                if c.Fire then
                    -- A failed Fire must not be reported as a click: the caller would
                    -- return before the firesignal / Activate fallbacks are tried.
                    if pcall(c.Fire, c) then fired = true end
                end
            end
        end
    end)
    if not fired and type(firesignal) == "function" then
        pcall(function()
            firesignal(btn.MouseButton1Click)
            fired = true
        end)
    end
    if not fired then
        pcall(function()
            btn:Activate()
            fired = true
        end)
    end
    return fired
end

function Automation.WarTycoonAutoBuildClickGui(needle, strict)
    local lp = Core.LocalPlayer
    local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
    if not pg then return false end
    local needleLow = string.lower(needle)

    local function paidAncestor(gui)
        local p = gui.Parent
        for _ = 1, 6 do
            if not p then break end
            local n = string.lower(p.Name)
            if n:find("shop", 1, true) or n:find("store", 1, true)
                or n:find("gamepass", 1, true) or n:find("robux", 1, true)
                or n:find("premium", 1, true) or n:find("purchase", 1, true) then
                return true
            end
            p = p.Parent
        end
        return false
    end

    for _, gui in ipairs(pg:GetDescendants()) do
        if gui:IsA("GuiButton") and gui.Visible
            and Automation.AutoRespawn and Automation.AutoRespawn.GuiVisible
            and Automation.AutoRespawn.GuiVisible(gui)
            and not (ScreenGui and gui:IsDescendantOf(ScreenGui)) then
            local text = ""
            if gui:IsA("TextButton") then text = tostring(gui.Text) end
            for _, d in ipairs(gui:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") then
                    text = text .. " " .. tostring(d.Text)
                end
            end
            local low = string.lower(text)
            if low:find(needleLow, 1, true)
                and not Automation.WarTycoonAutoBuildIsRobux(low) then
                local skip = false
                if strict then
                    if low:find("auto", 1, true) or low:find("buy", 1, true)
                        or low:find("purchase", 1, true) or low:find("gamepass", 1, true)
                        or low:find("product", 1, true) or low:find("r$", 1, true)
                        or low:find("vip", 1, true) or low:find("premium", 1, true)
                        or Automation.WarTycoonAutoBuildHasBarePrice(low)
                        or paidAncestor(gui) then
                        skip = true
                    end
                end
                if not skip then
                    return Automation.WarTycoonAutoBuildClickButton(gui)
                end
            end
        end
    end
    return false
end

function Automation.WarTycoonAutoBuildTryRebirth(base)
    if not Config.WarTycoonBuild.AutoRebirth then return false end
    Automation.WarTycoonAutoBuildState()
    local now = tick()
    if now - (Automation._wtLastRebirth or 0) < 4 then return false end
    Automation._wtLastRebirth = now

    base = base or Automation._wtBase or Automation.WarTycoonAutoBuildBase()
    local bad = {
        "auto", "buy", "purchase", "donate", "donation", "robux", "gamepass",
        "product", "vip", "premium", "pack", "bundle", "shop", "store", "r$",
    }
    local target
    if base and base.Parent then
        for _, obj in ipairs(base:GetDescendants()) do
            if obj:IsA("BasePart") and string.lower(obj.Name):find("rebirth", 1, true) then
                local model = obj:FindFirstAncestorOfClass("Model")
                if model == base or (model and not model:IsDescendantOf(base)) then model = nil end
                local scope = model or obj
                local label, price, robux, texts = Automation.WarTycoonAutoBuildPadInfo(scope)
                local combined = string.lower(obj.Name .. " " .. (model and model.Name or "")
                    .. " " .. tostring(label or "") .. " " .. tostring(texts or ""))
                if not robux and not Automation.WarTycoonAutoBuildIsRobux(combined)
                    and not Automation.WarTycoonAutoBuildHasWords(combined, bad)
                    and not Automation.WarTycoonAutoBuildHasProductSignal(scope)
                    and not Automation.WarTycoonAutoBuildHasDeadHint(combined)
                    and not Automation.WarTycoonAutoBuildHasBarePrice(texts) then
                    -- [ v90 ] War Tycoon rebirth is also a touch pad. A vertical
                    -- Rebirth sign/button is not a target; the free GUI button is
                    -- handled as a fallback below.
                    local usable = Automation.WarTycoonAutoBuildIsFlatDisc(obj)
                        and obj.CanTouch ~= false
                    local visible = (tonumber(obj.Transparency) or 0) < 0.98
                        or Automation.WarTycoonAutoBuildHasVisibleSign(obj, model)
                    if usable and visible then
                        target = obj
                        break
                    end
                end
            end
        end
    end
    if target then
        Automation.WarTycoonAutoBuildLog("rebirth: stepping on '" .. target.Name .. "'", Color3.fromRGB(255, 255, 0))
        if not Automation.WarTycoonAutoBuildHover(target, base) then
            Automation.WarTycoonAutoBuildLog("rebirth: could not reach '" .. target.Name .. "'", Color3.fromRGB(255, 140, 0))
            return false
        end
        Automation._wtStats.rebirths = Automation._wtStats.rebirths + 1
        Automation.WarTycoonAutoBuildStatus("AUTO BUILD  >  rebirth " .. tostring(Automation._wtStats.rebirths))
        return true
    end

    if Automation.WarTycoonAutoBuildClickGui("rebirth", true) then
        Automation._wtStats.rebirths = Automation._wtStats.rebirths + 1
        Automation.WarTycoonAutoBuildLog("rebirth: clicked the free UI button", Color3.fromRGB(255, 255, 0))
        Automation.WarTycoonAutoBuildStatus("AUTO BUILD  >  rebirth " .. tostring(Automation._wtStats.rebirths))
        return true
    end
    return false
end

-- [ v78 ] Snapshot a pad's state so a purchase can be detected even when the
-- cash value is not readable (no price tag / no leaderstats in this session).
function Automation.WarTycoonAutoBuildPadSnapshot(unit)
    local part = unit and unit.part
    if not part or not part.Parent then return nil end
    return {
        canCollide = part.CanCollide,
        transparency = part.Transparency,
        anchored = part.Anchored,
        name = part.Name,
        children = unit.model and #unit.model:GetChildren() or 0,
        position = part.Position,
        size = part.Size,
        modelPosition = (function()
            if not unit.model or not unit.model:IsA("Model") then return nil end
            local ok, pos = pcall(function() return unit.model:GetPivot().Position end)
            return ok and pos or nil
        end)(),
        anchorAlive = (unit.anchor == nil or unit.anchor.Parent ~= nil),
        label = unit.label,
        price = unit.price,
    }
end

function Automation.WarTycoonAutoBuildPadChanged(unit, snap)
    if not snap then return false end
    local part = unit and unit.part
    if not part or not part.Parent then return true end
    if unit.anchor and not unit.anchor.Parent then return true end
    if (part.Position - snap.position).Magnitude > 1.5 then return true end
    if (part.Size - snap.size).Magnitude > 1 then return true end
    if part.CanCollide ~= snap.canCollide then return true end
    if math.abs(part.Transparency - snap.transparency) > 0.01 then return true end
    if part.Anchored ~= snap.anchored then return true end
    if part.Name ~= snap.name then return true end
    -- In a multi-pad model, children change when ANY pad is bought. Only a
    -- single-pad model may use its children/pivot as proof for this pad.
    if unit.scope == unit.model and unit.model
        and (not unit.model.Parent or #unit.model:GetChildren() ~= snap.children) then return true end
    if unit.scope == unit.model and unit.model and snap.modelPosition then
        local ok, pos = pcall(function() return unit.model:GetPivot().Position end)
        if ok and pos and (pos - snap.modelPosition).Magnitude > 2 then return true end
    end
    local label, price = Automation.WarTycoonAutoBuildPadInfo(unit.scope or unit.part)
    if label ~= snap.label then return true end
    if price ~= snap.price then return true end
    return false
end

function Automation.WarTycoonAutoBuildTryPad(base, unit)
    Automation.WarTycoonAutoBuildState()
    if not unit or not unit.key then return false end
    if not unit.part or not unit.part.Parent then
        Automation._wtDonePads[unit.key] = tick() + 30
        Automation._wtPads = nil
        return false
    end
    if not base or not base.Parent or not unit.part:IsDescendantOf(base) then
        Automation._wtPads = nil
        return false
    end
    local anchor = unit.anchor or unit.part
    if not anchor.Parent or not anchor:IsDescendantOf(base) then
        Automation._wtDonePads[unit.key] = math.huge
        Automation._wtPads = nil
        return false
    end

    if unit.folder then
        -- [ v90 ] UnpurchasedButtons is the authoritative list. The button can
        -- be vertical and have no SurfaceGui price; price comes from its name.
        -- Only verify that it is still inside that folder and touchable.
        local folder = base:FindFirstChild("UnpurchasedButtons", true)
        if not folder or not unit.part or not unit.part.Parent
            or not unit.part:IsDescendantOf(folder) or unit.part.CanTouch == false then
            Automation._wtDonePads[unit.key] = math.huge
            Automation._wtPads = nil
            return false
        end
    else
        -- Re-read the pad right before moving. A bought pad often keeps its part
        -- but disables/hides the sign; a cached unit would keep TP-ing to a ghost.
        local scope = unit.scope or unit.model or anchor
        local infoLabel, infoPrice, infoRobux, infoTexts = Automation.WarTycoonAutoBuildPadInfo(scope)
        local info = {
            label = infoLabel,
            price = infoPrice,
            robux = infoRobux,
            texts = infoTexts,
            product = Automation.WarTycoonAutoBuildHasProductSignal(scope),
        }
        local eval, reason = Automation.WarTycoonAutoBuildPadEval(anchor, unit.model, scope, info, base)
        if not eval then
            local cooldown = 30
            if reason == "robux/donation" then
                cooldown = math.huge
            elseif reason == "sold/owned/locked" or reason == "bare price (possible Robux)"
                or reason == "cash offer" or reason == "tiny price (donation?)"
                or reason == "generic buy button" then
                cooldown = 120
            elseif reason == "invisible" or reason == "display, not a pad" or reason == "no cash price" then
                cooldown = 60
            end
            Automation._wtDonePads[unit.key] = tick() + cooldown
            if reason == "robux/donation" then
                Automation.WarTycoonAutoBuildLog("skipped donation/Robux pad: "
                    .. tostring(unit.label or unit.part.Name), Color3.fromRGB(255, 170, 0))
            end
            Automation._wtPads = nil
            return false
        end
        local occupied, blocker = Automation.WarTycoonAutoBuildHasBuildingOn(anchor, base)
        if occupied then
            Automation._wtDonePads[unit.key] = tick() + 120
            Automation._wtPads = nil
            Automation.WarTycoonAutoBuildLog("skipped occupied pad: "
                .. tostring(unit.label or unit.part.Name)
                .. " (" .. tostring(blocker and blocker.Name or "object") .. ")",
                Color3.fromRGB(255, 170, 0))
            return false
        end
        if eval.trigger and eval.trigger.Parent and eval.trigger:IsDescendantOf(base) then
            unit.part = eval.trigger
        end
        if eval.price ~= nil then unit.price = eval.price end
        if eval.label then unit.label = eval.label end
    end

    if unit.price ~= nil then
        local money = Automation.WarTycoonAutoBuildMoney()
        if money and money < unit.price then
            Automation._wtPads = nil
            return false
        end
    end

    local tag = string.format("'%s'%s", tostring(unit.label or unit.part.Name),
        unit.price and (" ($" .. tostring(math.floor(unit.price)) .. ")") or "")
    local hover = tonumber(Config.WarTycoonBuild.Hover) or 2.5
    Automation.WarTycoonAutoBuildLog("TP above pad " .. tag .. " (+" .. tostring(hover) .. " studs)")

    local attempts = math.clamp(math.floor(tonumber(Config.WarTycoonBuild.Attempts) or 2), 1, 3)
    for i = 1, attempts do
        if not Config.WarTycoonBuild.Enabled or State.Unloading or not IsCurrentInstance() then return false end
        local moneyBefore = Automation.WarTycoonAutoBuildMoney()
        local partBefore = unit.part
        local snapBefore = Automation.WarTycoonAutoBuildPadSnapshot(unit)
        local okTp, tpErr = Automation.WarTycoonAutoBuildHover(unit.part, base)
        if not okTp and tpErr and tpErr:find("no living", 1, true) then return false end
        if not okTp and tpErr and tpErr:find("not in your base", 1, true) then
            Automation._wtPads = nil
            return false
        end
        if not okTp and tpErr and tpErr:find("rolled back", 1, true) then
            Automation.WarTycoonAutoBuildLog("TP rolled back -> walking to the pad instead", Color3.fromRGB(255, 140, 0))
            Automation.WarTycoonAutoBuildStatus("AUTO BUILD  >  walking (TP blocked)")
            if Config.WarTycoonBuild.WalkFallback ~= false then
                Automation.WarTycoonAutoBuildWalk(unit.part)
            end
        end
        task.wait(tonumber(Config.WarTycoonBuild.Delay) or 0.35)

        local moneyAfter = Automation.WarTycoonAutoBuildMoney()
        local gone = (partBefore == nil) or (partBefore.Parent == nil)
            or (unit.model ~= nil and unit.model.Parent == nil)
            or (anchor ~= nil and anchor.Parent == nil)
        local cashDropped = moneyBefore ~= nil and moneyAfter ~= nil and moneyAfter < moneyBefore
        local paidKnown = unit.price ~= nil and unit.price > 0
            and moneyBefore ~= nil and moneyAfter ~= nil
            and (moneyBefore - moneyAfter) >= (unit.price * 0.6)
        local paid = paidKnown or (unit.price == nil and cashDropped)
        local changed = (not gone) and (not paid)
            and Automation.WarTycoonAutoBuildPadChanged(unit, snapBefore)

        if gone or paid or changed then
            Automation._wtStats.purchases = Automation._wtStats.purchases + 1
            if unit.price and (paidKnown or gone) then
                Automation._wtStats.spent = Automation._wtStats.spent + unit.price
            end
            Automation.WarTycoonAutoBuildLog("bought: " .. tag, Color3.fromRGB(0, 255, 120))
            local retryAt = math.huge
            if not gone then
                local confirmed = paidKnown
                retryAt = confirmed and (tick() + 600) or (tick() + 120)
            end
            Automation._wtDonePads[unit.key] = retryAt
            Automation._wtPadFails[unit.key] = nil
            Automation._wtPadsSeen = true
            Automation._wtSaveSince = nil
            Automation._wtSaveKey = nil
            Automation._wtPads = nil
            Automation._wtStuckSince = nil
            return true
        end
        Automation.WarTycoonAutoBuildLog(string.format("pad %s did not register (attempt %d/%d)", tag, i, attempts), Color3.fromRGB(255, 180, 0))
    end

    -- [ v90 ] A pad that failed repeatedly is usually a ghost: the sign stayed
    -- but the purchase button is gone. Back off exponentially instead of
    -- teleporting to it every 30 s forever.
    Automation._wtPadFails = Automation._wtPadFails or {}
    local fails = (Automation._wtPadFails[unit.key] or 0) + 1
    Automation._wtPadFails[unit.key] = fails
    local cooldown = math.min(600, 60 * (2 ^ math.min(fails - 1, 3)))
    Automation._wtDonePads[unit.key] = tick() + cooldown
    if fails >= 3 then
        Automation.WarTycoonAutoBuildLog(string.format(
            "pad %s failed %d times - pausing %ds (old/ghost pad?)",
            tag, fails, cooldown), Color3.fromRGB(255, 140, 0))
    end
    Automation._wtPads = nil
    return false
end

function Automation.WarTycoonAutoBuildNextPad(pads)
    if not pads then return nil end
    Automation.WarTycoonAutoBuildState()
    local now = tick()
    for _, u in ipairs(pads) do
        local skipUntil = Automation._wtDonePads[u.key]
        if not skipUntil or now >= skipUntil then
            return u
        end
    end
    return nil
end

-- Do we need to go collect cash before the next purchase?
function Automation.WarTycoonAutoBuildWantCash(unit)
    local now = tick()
    local since = now - (Automation._wtLastCollect or 0)
    if since < 3 then return false end
    local fallback = tonumber(Config.WarTycoonBuild.CollectFallback) or 15
    if Config.WarTycoonBuild.CollectWhenShort == false then
        return since >= fallback
    end
    if unit and unit.price then
        local money = Automation.WarTycoonAutoBuildMoney()
        return (money == nil) or (money < unit.price)
    end
    return since >= fallback
end

function Automation.WarTycoonAutoBuildLoop()
    if Automation._wtLoopActive then return end
    Automation._wtLoopActive = true
    task.spawn(function()
        if not Automation.WarTycoonAutoBuildPriorityOrder[Config.WarTycoonBuild.Priority] then
            Config.WarTycoonBuild.Priority = "Money"
        end
        -- [ v54 ] fresh session stats on every start
        Automation._wtStats = { purchases = 0, rebirths = 0, rollbacks = 0, spent = 0, errors = 0, startedAt = tick() }
        -- [ v78 ] a leftover "stuck" timer from a previous run must not trigger an instant rebirth
        Automation._wtStuckSince = nil
        -- [ v89 ] запоминаем точку старта: по ней выбирается СВОЙ плот, если у
        -- нескольких плотов одинаковый командный владелец
        local startChar = Core.LocalPlayer and Core.LocalPlayer.Character
        local startHrp = startChar and startChar:FindFirstChild("HumanoidRootPart")
        Automation._wtHomePos = startHrp and startHrp.Position or nil
        Automation._wtLastChar = startChar
        Automation._wtPadFails = {}
        -- [ v87 ] rebirth разрешаем только после того, как в этой сессии реально видели пады:
        -- если сканер сломался, авто-билд не должен ребить базу вслепую
        Automation._wtPadsSeen = false
        Automation._wtSaveSince = nil
        Automation._wtSaveKey = nil
        Automation.WarTycoonAutoBuildLog("started. Priority: " .. tostring(Config.WarTycoonBuild.Priority)
            .. ", TP above pad: +" .. tostring(Config.WarTycoonBuild.Hover) .. " studs", Color3.fromRGB(0, 255, 150))
        Automation.WarTycoonAutoBuildStatus("AUTO BUILD  >  starting...")
        local stopReason = "stopped by user"
        while Config.WarTycoonBuild.Enabled and not State.Unloading and IsCurrentInstance() do
            local limit = Automation.WarTycoonAutoBuildLimitReached()
            if limit then
                Automation.WarTycoonAutoBuildLog("stopping: " .. limit, Color3.fromRGB(255, 220, 0))
                stopReason = limit
                Config.WarTycoonBuild.Enabled = false
                -- keep the card switch in sync with the auto-stop
                local mod = State.Modules and State.Modules["Auto Build"]
                if mod and mod.Set then pcall(function() mod.Set(false, false, true) end) end
                break
            end
            local ok, err = pcall(function()
                -- [ v90 ] a respawn / plot reset invalidates cached pads and the
                -- base; otherwise Auto Build keeps TP-ing to the old pad spots.
                local curChar = Core.LocalPlayer and Core.LocalPlayer.Character
                if curChar and Automation._wtLastChar ~= curChar then
                    Automation._wtLastChar = curChar
                    Automation._wtBase = nil
                    Automation._wtBaseAt = 0
                    Automation._wtPads = nil
                    Automation._wtPadsBase = nil
                    Automation._wtDonePads = {}
                    Automation._wtPadFails = {}
                    Automation._wtPadsSeen = false
                    Automation._wtSaveSince = nil
                    Automation._wtSaveKey = nil
                    Automation._wtStuckSince = nil
                    local chrHrp = curChar:FindFirstChild("HumanoidRootPart")
                    if chrHrp then Automation._wtHomePos = chrHrp.Position end
                end
                local base = Automation.WarTycoonAutoBuildBase(false)
                if not base or not base.Parent then
                    Automation._wtBase = nil
                    -- [ v87 ] не молчим вечно: без своей базы авто-билд ничего не делает
                    if tick() - (Automation._wtNoBaseAt or 0) > 30 then
                        Automation._wtNoBaseAt = tick()
                        Automation.WarTycoonAutoBuildLog(
                            "own base not found - stand on your plot; use 'Dump pads to F9' to check",
                            Color3.fromRGB(255, 170, 0))
                    end
                    task.wait(2)
                    return
                end
                Automation._wtNoBaseAt = nil

                local pads = Automation.WarTycoonAutoBuildPads(base, false)
                if #pads > 0 then Automation._wtPadsSeen = true end
                local unit = nil
                if #pads > 0 then
                    unit = Automation.WarTycoonAutoBuildNextPad(pads)
                end

                if Config.WarTycoonBuild.AutoCollect and Automation.WarTycoonAutoBuildWantCash(unit) then
                    local collector = Automation.WarTycoonAutoBuildFindCollector(base)
                    if collector then
                        Automation.WarTycoonAutoBuildLog("cash is short -> collecting at '" .. collector.Name .. "'", Color3.fromRGB(255, 220, 0))
                        Automation.WarTycoonAutoBuildUpdateStatus(nil, "collecting cash at '" .. collector.Name .. "'")
                        Automation.WarTycoonAutoBuildHover(collector)
                        Automation._wtLastCollect = tick()
                        task.wait(0.2)
                        return
                    end
                end

                -- [ v87 ] не телепортируемся к недоступному паду: сначала копим/собираем
                if unit and unit.price and unit.price > 0 then
                    -- The saving timer belongs to one pad. Without a key, a timer left by
                    -- the previous (now skipped) pad made the next purchase attempt fire at once.
                    if Automation._wtSaveKey ~= unit.key then
                        Automation._wtSaveKey = unit.key
                        Automation._wtSaveSince = nil
                    end
                    local money = Automation.WarTycoonAutoBuildMoney()
                    if money and money < unit.price then
                        -- не ждём вечно, если ценник распознан неверно: через 10 s пробуем всё равно
                        Automation._wtSaveSince = Automation._wtSaveSince or tick()
                        if tick() - Automation._wtSaveSince < 10 then
                            Automation.WarTycoonAutoBuildUpdateStatus(nil, string.format(
                                "saving up $%s / $%s",
                                Automation.WarTycoonAutoBuildFormatMoney(money),
                                Automation.WarTycoonAutoBuildFormatMoney(unit.price)))
                            task.wait(0.8)
                            return
                        end
                        Automation._wtSaveSince = nil
                    else
                        Automation._wtSaveSince = nil
                        Automation._wtSaveKey = nil
                    end
                end

                if not unit then
                    -- [ v78 ] One failed pad must not wipe the base. Pads are often just on
                    -- cooldown - rebirth only when the plot has nothing left to buy.
                    Automation.WarTycoonAutoBuildState()
                    -- [ v78 ] If nothing is buyable for a full minute (every pad keeps
                    -- bouncing back), treat the base as stuck and allow a rebirth again.
                    Automation._wtStuckSince = Automation._wtStuckSince or tick()
                    Automation._wtSaveSince = nil
                    Automation._wtSaveKey = nil
                    local stuckFor = tick() - Automation._wtStuckSince
                    local allBought = #pads > 0
                    for _, u in ipairs(pads) do
                        if (Automation._wtDonePads[u.key] or 0) ~= math.huge then
                            allBought = false
                            break
                        end
                    end
                    if #pads > 0 and not allBought and stuckFor < 60 then
                        Automation.WarTycoonAutoBuildUpdateStatus(nil, "pads on cooldown - waiting")
                        if (tick() - (Automation._wtCooldownLog or 0)) > 20 then
                            Automation._wtCooldownLog = tick()
                            Automation.WarTycoonAutoBuildLog("all known pads are on cooldown - waiting instead of rebirthing", Color3.fromRGB(255, 200, 0))
                        end
                        task.wait(1)
                        return
                    end
                    -- [ v87 ] если денег меньше самого дешёвого пада, это не "застряло":
                    -- ребёрт обнулит базу, поэтому ждём и копим
                    local cheapest, moneyNow
                    for _, u in ipairs(pads) do
                        local skipUntil = Automation._wtDonePads[u.key]
                        if (not skipUntil or tick() >= skipUntil) and u.price and u.price > 0 then
                            if not cheapest or u.price < cheapest then cheapest = u.price end
                        end
                    end
                    if cheapest then moneyNow = Automation.WarTycoonAutoBuildMoney() end
                    local tooPoor = cheapest ~= nil and moneyNow ~= nil and moneyNow < cheapest

                    if tooPoor and not allBought then
                        Automation.WarTycoonAutoBuildUpdateStatus(nil, string.format(
                            "saving up $%s / $%s - rebirth paused",
                            Automation.WarTycoonAutoBuildFormatMoney(moneyNow),
                            Automation.WarTycoonAutoBuildFormatMoney(cheapest)))
                        if tick() - (Automation._wtPoorLog or 0) > 20 then
                            Automation._wtPoorLog = tick()
                            Automation.WarTycoonAutoBuildLog(
                                "not enough cash for the cheapest pad - waiting instead of rebirthing",
                                Color3.fromRGB(255, 200, 0))
                        end
                        task.wait(1.5)
                        return
                    end

                    Automation._wtStuckSince = nil
                    if #pads > 0 and not allBought then
                        Automation.WarTycoonAutoBuildLog("pads stayed un-buyable for " .. tostring(math.floor(stuckFor)) .. "s - trying a rebirth", Color3.fromRGB(255, 200, 0))
                    end
                    Automation.WarTycoonAutoBuildUpdateStatus(nil, #pads == 0 and "waiting for pads" or (allBought and "base built - waiting for rebirth" or "stuck - rebirth"))
                    if #pads == 0 and (tick() - (Automation._wtNoPadLog or 0)) > 30 then
                        Automation._wtNoPadLog = tick()
                        Automation.WarTycoonAutoBuildLog(Automation._wtPadsSeen
                            and "no purchase pads detected - turn on 'Dump pads to F9' to check"
                            or "no purchase pads detected - auto-rebirth paused until pads appear (use 'Dump pads to F9' to check)",
                            Color3.fromRGB(255, 170, 0))
                    end
                    if Config.WarTycoonBuild.AutoRebirth and Automation._wtPadsSeen then
                        local didRb = Automation.WarTycoonAutoBuildTryRebirth()
                        if didRb then
                            -- the plot resets on rebirth, so rescan everything
                            Automation._wtPads = nil
                            Automation._wtDonePads = {}
                            Automation._wtBaseAt = 0
                            Automation._wtPadsSeen = false
                            Automation._wtHomePos = nil
                            local rbChar = Core.LocalPlayer and Core.LocalPlayer.Character
                            local rbHrp = rbChar and rbChar:FindFirstChild("HumanoidRootPart")
                            if rbHrp then Automation._wtHomePos = rbHrp.Position end
                        end
                    elseif Config.WarTycoonBuild.AutoRebirth then
                        Automation.WarTycoonAutoBuildUpdateStatus(nil, "no pads found - rebirth paused")
                    end
                    task.wait(2.5)
                    return
                end

                Automation.WarTycoonAutoBuildTryPad(base, unit)
            end)
            if not ok then
                Automation._wtStats.errors = Automation._wtStats.errors + 1
                Automation.WarTycoonAutoBuildLog("error: " .. tostring(err), Color3.fromRGB(255, 60, 60))
                task.wait(1)
            end
        end
        Automation._wtLoopActive = false
        if IsCurrentInstance() and not State.Unloading then
            Automation.WarTycoonAutoBuildReport(stopReason)
        end
        Automation.WarTycoonAutoBuildStatus(nil)
        Automation.WarTycoonAutoBuildLog("stopped: " .. stopReason, Color3.fromRGB(255, 90, 90))
    end)
end

-- Diagnostics
function Automation.WarTycoonAutoBuildDump()
    local base = Automation.WarTycoonAutoBuildBase(true)
    if not base then
        Automation.WarTycoonAutoBuildLog("dump: own base not found (make sure you are on your own plot)", Color3.fromRGB(255, 80, 80))
        return
    end
    Automation.WarTycoonAutoBuildLog("dump: base " .. tostring(base:GetFullName()))
    local pads = Automation.WarTycoonAutoBuildScanPads(base)
    Automation.WarTycoonAutoBuildLog("dump: candidate pads " .. #pads .. " (priority: " .. tostring(Config.WarTycoonBuild.Priority) .. ")")
    local btnFolder = base:FindFirstChild("UnpurchasedButtons", true)
    if btnFolder then
        local names = {}
        for _, c in ipairs(btnFolder:GetChildren()) do names[#names + 1] = c.Name end
        Automation.WarTycoonAutoBuildLog("dump: UnpurchasedButtons " .. #names .. " -> "
            .. string.sub(table.concat(names, " | "), 1, 900))
    else
        Automation.WarTycoonAutoBuildLog("dump: UnpurchasedButtons NOT FOUND - using fallback scan",
            Color3.fromRGB(255, 170, 0))
    end
    for i, u in ipairs(pads) do
        print(string.format("[AUTO-BUILD] #%d cat=%-6s price=%-9s label='%s' part=%s",
            i, tostring(u.cat), tostring(u.price), tostring(u.label or ""),
            u.part and u.part:GetFullName() or "-"))
    end
    local skipped = Automation._wtLastSkipped or {}
    if #skipped > 0 then
        Automation.WarTycoonAutoBuildLog("dump: skipped Robux/donation offers: " .. #skipped,
            Color3.fromRGB(255, 180, 0))
        for i, s in ipairs(skipped) do
            print(string.format("[AUTO-BUILD] skip #%d [%s] label='%s' part=%s",
                i, tostring(s.reason or "excluded"), tostring(s.label or ""), tostring(s.name or "-")))
        end
    end
    -- [ v90 ] When 0 pads are found, explain every flat floor part: missing
    -- cash price, sign-only, collision name, or an object already on the pad.
    local flatCount, shown = 0, 0
    for _, d in ipairs(base:GetDescendants()) do
        if d:IsA("BasePart") and Automation.WarTycoonAutoBuildIsFlatDisc(d) then
            flatCount = flatCount + 1
            if shown < 40 then
                local model = d:FindFirstAncestorOfClass("Model")
                if model and not model:IsDescendantOf(base) then model = nil end
                local scope = d
                if model and model ~= base and #model:GetChildren() <= 40 then scope = model end
                local label, price, robux, texts = Automation.WarTycoonAutoBuildPadInfo(scope)
                local info = {
                    label = label, price = price, robux = robux, texts = texts,
                    product = Automation.WarTycoonAutoBuildHasProductSignal(scope), scope = scope,
                }
                local eval, reason = Automation.WarTycoonAutoBuildPadEval(d, model, scope, info, base)
                local occupied, blocker = Automation.WarTycoonAutoBuildHasBuildingOn(d, base)
                print(string.format(
                    "[AUTO-BUILD] flat '%s' label='%s' price=%s eval=%s occupied=%s",
                    d:GetFullName(), tostring(eval and eval.label or label or ""),
                    tostring(price), eval and "yes" or tostring(reason),
                    occupied and ("yes (" .. tostring(blocker and blocker.Name or "?") .. ")") or "no"))
                shown = shown + 1
            end
        end
    end
    Automation.WarTycoonAutoBuildLog("dump: flat floor parts " .. flatCount)
    -- If the real touch pads are thick/vertical, their names still show here.
    local namedCount, namedShown = 0, 0
    for _, d in ipairs(base:GetDescendants()) do
        if d:IsA("BasePart") and not Automation.WarTycoonAutoBuildIsFlatDisc(d) then
            local n = string.lower(d.Name)
            if n:find("collision", 1, true) or n:find("pad", 1, true)
                or n:find("button", 1, true) or n:find("touch", 1, true)
                or n:find("trigger", 1, true) or n:find("click", 1, true) then
                namedCount = namedCount + 1
                if namedShown < 30 then
                    print(string.format(
                        "[AUTO-BUILD] nonflat '%s' size=%s pos=%s touch=%s transparent=%.2f click=%s prompt=%s",
                        d:GetFullName(), tostring(d.Size), tostring(d.Position), tostring(d.CanTouch),
                        tonumber(d.Transparency) or 0,
                        tostring(Automation.WarTycoonAutoBuildHasClick(d)),
                        tostring(Automation.WarTycoonAutoBuildHasPrompt(d))))
                    namedShown = namedShown + 1
                end
            end
        end
    end
    Automation.WarTycoonAutoBuildLog("dump: non-flat touch-like parts " .. namedCount)
    local coll = Automation.WarTycoonAutoBuildFindCollector(base)
    print("[AUTO-BUILD] collector: " .. tostring(coll and coll:GetFullName() or "NOT FOUND"))
    local names = {}
    for _, c in ipairs(base:GetChildren()) do
        names[#names + 1] = c.ClassName .. ":" .. c.Name
    end
    print("[AUTO-BUILD] base children (" .. #names .. "): " .. string.sub(table.concat(names, " | "), 1, 900))
    Automation.WarTycoonAutoBuildLog("dump ready - copy the [AUTO-BUILD] lines from F9 and send them", Color3.fromRGB(0, 255, 150))
end

-- [ v54 ] OVERMIND USERS
Automation.BadgePeers = {}
Automation.BadgeGuis = {}
Automation.BadgeReady = false

-- [ v77 ] Значки над игроками может отдавать любой из наших сервисов: свой Node на хосте
-- и воркер на Cloudflare — контракт /api/presence у них один (см. Server/README.md).
-- Если один лежит (503 «Site temporarily unavailable»), клиент сам берёт второй и запоминает
-- рабочий, поэтому пауза хостинга воркера больше не ломает модуль Overmind Users.
Automation.BadgeEndpoints = {
    "https://site-f8cb0f2505414f00a5c0892490f3376d.freebuff.page/api/presence",
    "http://node4.waifly.com:25088/api/presence",
}
-- [ v73 ] Адрес по умолчанию и запасной: если в настройках лежит мусор (в сохранённых
-- конфигах встречалось «1»), берём этот и говорим об этом один раз, а не сыпем ошибкой.
Automation.BadgeDefaultEndpoint = Automation.BadgeEndpoints[1]

-- [ v55 ] The badge tables are created on demand as well
function Automation.BadgeState()
    Automation.BadgePeers = Automation.BadgePeers or {}
    Automation.BadgeGuis = Automation.BadgeGuis or {}
    return Automation.BadgePeers
end

function Automation.BadgeIdentity()
    local lp = Core.LocalPlayer
    local job = ""
    pcall(function() job = tostring(game.JobId) end)
    return {
        place = tostring(game.PlaceId or 0),
        job = job,
        user = tostring(lp and lp.UserId or 0),
        name = tostring(lp and lp.Name or ""),
    }
end

function Automation.BadgeEncode(s)
    if Core.Services.HttpService and Core.Services.HttpService.UrlEncode then
        local ok, res = pcall(function() return Core.Services.HttpService:UrlEncode(tostring(s)) end)
        if ok and res then return res end
    end
    return (tostring(s):gsub("[^%w%-%.~_]", function(c)
        return string.format("%%%02X", string.byte(c))
    end))
end

-- [ v73 ] GET текстом: сначала транспорт исполнителя (тот же, что у Friend System), потом game:HttpGet.
-- Раньше был только game:HttpGet, и любой его сбой выглядел в островке как «bad response».
function Automation.HttpGetText(url)
    local body, err = Automation.FriendSendOnce("GET", url)
    if body then return body end
    local ok, raw = pcall(function() return game:HttpGet(url, true) end)
    if ok and type(raw) == "string" and raw ~= "" then return raw end
    return nil, tostring(err or raw or "no http transport")
end

-- [ v77 ] Приводим ЛЮБОЙ адрес в вид ДО запроса (раньше это делалось только для поля настроек).
function Automation.BadgeNormalizeUrl(raw)
    local endpoint = tostring(raw or ""):gsub("%s+", "")
    if endpoint == "" then return nil, "empty endpoint" end
    -- годится полный URL или хотя бы «host.tld» без схемы
    if not endpoint:match("^https?://") then
        if not endpoint:match("^[%w%.%-]+%.[%a][%a]+") then
            return nil, "endpoint is not a URL: " .. endpoint
        end
        endpoint = "https://" .. endpoint
    end
    local host, rest = endpoint:match("^(https?://[^/]+)(.*)$")
    if not host then return nil, "endpoint is not a URL: " .. endpoint end
    local path, query = rest:match("^([^?]*)(.*)$")
    path = path:gsub("/+$", "")
    if path == "" then path = "/api/presence" end   -- корень сервиса отдаёт описание, а не список
    return host .. path .. query
end

-- [ v73 ] Строка «1» в поле настроек раньше молча уходила в game:HttpGet и возвращалась
-- «bad response»; теперь это понятная причина без запроса.
function Automation.BadgeEndpointUrl()
    local endpoint = tostring(Config.Badge.Endpoint or ""):gsub("%s+", "")
    Automation.BadgeEndpointFallback = false
    local normalized, why = Automation.BadgeNormalizeUrl(endpoint)
    if not normalized then
        local builtin = tostring(Automation.BadgeDefaultEndpoint or "")
        if builtin == "" then
            if endpoint == "" then return nil, "no endpoint" end
            return nil, "endpoint is not a URL: " .. endpoint
        end
        Automation.BadgeEndpointFallback = true
        normalized, why = Automation.BadgeNormalizeUrl(builtin)
        if not normalized then return nil, why end
    end
    return normalized
end

function Automation.BadgeUrlFor(endpoint)
    local normalized, why = Automation.BadgeNormalizeUrl(endpoint)
    if not normalized then return nil, why end
    local id = Automation.BadgeIdentity()
    local params = table.concat({
        "place=" .. Automation.BadgeEncode(id.place),
        "job=" .. Automation.BadgeEncode(id.job),
        "user=" .. Automation.BadgeEncode(id.user),
        "name=" .. Automation.BadgeEncode(id.name),
    }, "&")
    if Config.Badge.OnlySameServer == false then params = params .. "&any=1" end
    return normalized .. (normalized:find("?", 1, true) and "&" or "?") .. params
end

function Automation.BadgeUrl()
    local endpoint, why = Automation.BadgeEndpointUrl()
    if not endpoint then return nil, why end
    return Automation.BadgeUrlFor(endpoint)
end

function Automation.BadgeParsePeers(body)
    local text = tostring(body or "")
    if text == "" then return nil, "empty response - check the endpoint" end
    local ok, decoded = pcall(function() return Core.Services.HttpService:JSONDecode(text) end)
    if not ok or type(decoded) ~= "table" then
        -- [ v73 ] Вместо молчаливого «bad response» показываем начало тела: обычно это HTML
        -- хостинга или чужой сервис, а не наш API.
        -- [ v77 ] Если JSON в теле вообще нет — это страница хостинга («Site unavailable»,
        -- «Site temporarily unavailable»), а не битый ответ. Пишем причину как она есть.
        local snippet = string.sub((text:gsub("%s+", " ")), 1, 48)
        if not text:find("{", 1, true) then
            return nil, "service not answering: " .. snippet
        end
        return nil, "not json: " .. snippet
    end
    if type(decoded.peers) ~= "table" then
        local hint = decoded.service and " (this is the service root, use /api/presence)" or ""
        return nil, "response has no peers field" .. hint
    end
    local peers = {}
    for _, p in ipairs(decoded.peers) do
        local uid = tonumber(p and p.user)
        if uid and uid > 0 then
            peers[uid] = { name = tostring(p.name or ""), seen = tonumber(p.seen) or 0 }
        end
    end
    return peers
end

-- [ v77 ] Порядок попыток: сначала адрес, который уже ответил (его запоминаем), потом адрес
-- из настроек, потом остальные наши сервисы. Лежащий воркер поэтому не тормозит цикл:
-- опрос идёт в живой сервис, а рабочий адрес остаётся выбранным до следующего перезапуска.
function Automation.BadgeCandidateUrls()
    local urls, seen = {}, {}
    local function push(raw)
        if raw == nil or raw == "" then return end
        local normalized = Automation.BadgeNormalizeUrl(raw)
        if normalized and not seen[normalized] then
            seen[normalized] = true
            table.insert(urls, normalized)
        end
    end
    push(Automation.BadgeActiveEndpoint)
    local configured = Automation.BadgeEndpointUrl()
    push(configured)
    for _, raw in ipairs(Automation.BadgeEndpoints or {}) do push(raw) end
    return urls
end

-- [ v77 ] Один и тот же адрес с противоположной схемой: у нашего хостинга схема только одна
-- и угадать её нельзя (Cloudflare — https, Waifly — http). Нужна, потому что адрес без схемы
-- достраивается до https, и тогда http-хостинг вообще не отвечает.
function Automation.BadgeFlipScheme(endpoint)
    if endpoint:sub(1, 8) == "https://" then return "http://" .. endpoint:sub(9) end
    if endpoint:sub(1, 7) == "http://" then return "https://" .. endpoint:sub(8) end
    return nil
end

function Automation.BadgeTryEndpoint(endpoint)
    local url, why = Automation.BadgeUrlFor(endpoint)
    if not url then return nil, tostring(why or "no endpoint") end
    local body, err = Automation.HttpGetText(url)
    if not body then return nil, tostring(err or "no response") end
    local peers, parseErr = Automation.BadgeParsePeers(body)
    if not peers then return nil, tostring(parseErr or "bad response") end
    Automation.BadgePeers = peers
    Automation.BadgeReady = true
    Automation.BadgeActiveEndpoint = endpoint
    return peers
end

function Automation.BadgePoll()
    local lastErr = "no endpoint"
    local tried = {}
    -- [ v77 ] Вторая схема нужна только там, где схему достроили мы сами: у записанного без
    -- схемы адреса угадать её нельзя. Встроенные адреса перечислены уже с рабочей схемой, поэтому
    -- лишних запросов при обычном сбое не добавляется.
    local rawConfig = tostring(Config.Badge.Endpoint or ""):gsub("%s+", "")
    local schemeGuessed = rawConfig ~= "" and not rawConfig:match("^https?://")
    local configured = Automation.BadgeEndpointUrl()
    for _, endpoint in ipairs(Automation.BadgeCandidateUrls()) do
        tried[endpoint] = true
        local peers, err = Automation.BadgeTryEndpoint(endpoint)
        if peers then return true, peers end
        lastErr = err
        if schemeGuessed and endpoint == configured then
            local flipped = Automation.BadgeFlipScheme(endpoint)
            if flipped and not tried[flipped] then
                tried[flipped] = true
                peers, err = Automation.BadgeTryEndpoint(flipped)
                if peers then return true, peers end
                lastErr = err
            end
        end
    end
    return false, lastErr
end

function Automation.BadgeRemove(player)
    Automation.BadgeState()
    local gui = Automation.BadgeGuis[player]
    if gui then
        pcall(function() gui:Destroy() end)
        Automation.BadgeGuis[player] = nil
    end
end

function Automation.BadgeDraw(player, info)
    Automation.BadgeState()
    local char = player and player.Character
    local anchor = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
    if not anchor then
        Automation.BadgeRemove(player)
        return
    end

    local gui = Automation.BadgeGuis[player]
    if gui and gui.Parent ~= anchor then
        pcall(function() gui:Destroy() end)
        Automation.BadgeGuis[player] = nil
        gui = nil
    end

    if not gui then
        gui = Instance.new("BillboardGui")
        gui.Name = "OvermindBadge"
        gui.AlwaysOnTop = true
        gui.MaxDistance = 300
        gui.StudsOffset = Vector3.new(0, 2.4, 0)
        gui.Parent = anchor

        local logo = Instance.new("ImageLabel")
        logo.Name = "Logo"
        logo.BackgroundTransparency = 1
        logo.Parent = gui

        local label = Instance.new("TextLabel")
        label.Name = "Owner"
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextStrokeTransparency = 0.4
        label.Font = Theme.FontBold
        label.Parent = gui

        Automation.BadgeGuis[player] = gui
    end

    local size = math.clamp(tonumber(Config.Badge.Size) or 1, 0.5, 3)
    local showName = Config.Badge.ShowName ~= false
    gui.Size = UDim2.new(0, 40 * size, 0, 40 * size + (showName and 14 * size or 0))

    local logo = gui:FindFirstChild("Logo")
    if logo then
        logo.Size = UDim2.new(0, 32 * size, 0, 32 * size)
        logo.Position = UDim2.new(0.5, -16 * size, 0, 0)
        logo.Image = tostring(Config.Badge.Logo or "")
        logo.ImageColor3 = Config.Badge.Color or Color3.fromRGB(123, 97, 255)
    end

    local label = gui:FindFirstChild("Owner")
    if label then
        label.Visible = showName
        label.TextSize = math.max(8, math.floor(11 * size))
        label.Size = UDim2.new(1, 0, 0, 14 * size)
        label.Position = UDim2.new(0, 0, 0, 33 * size)
        label.Text = tostring((info and info.name) or player.Name)
    end
end

function Automation.BadgeClearAll()
    for player in pairs(Automation.BadgeGuis) do
        Automation.BadgeRemove(player)
    end
    Automation.BadgeGuis = {}
    Automation.BadgePeers = {}
end

function Automation.BadgeApply()
    local peers = Automation.BadgeState()
    local lp = Core.LocalPlayer
    for _, player in ipairs(Core.Services.Players:GetPlayers()) do
        local uid = tonumber(player.UserId)
        local isSelf = (player == lp)
        if isSelf and Config.Badge.IncludeSelf then
            Automation.BadgeDraw(player, { name = player.Name })
        elseif not isSelf and uid and peers[uid] then
            Automation.BadgeDraw(player, peers[uid])
        else
            Automation.BadgeRemove(player)
        end
    end
end

function Automation.BadgeLoop()
    task.spawn(function()
        -- [ v73 ] вместо «SET ENDPOINT URL»: если в поле не адрес, транспорт уже работает на
        -- встроенном — говорим об этом, чтобы игрок знал, какой адрес реально используется
        Automation.BadgeEndpointUrl()
        if Automation.BadgeEndpointFallback then
            _G.Log("Overmind Users: endpoint is not a URL - using the built-in one", Color3.fromRGB(255, 180, 0))
            if Internal.ShowIslandNotification then
                Internal.ShowIslandNotification("BADGE: USING BUILT-IN ENDPOINT", Color3.fromRGB(255, 180, 0))
            end
        end
        while Config.Badge.Enabled and not State.Unloading and IsCurrentInstance() do
            local ok, res = Automation.BadgePoll()
            -- [ v73 ] Причину показываем один раз на изменение: при ошибке в настройках
            -- островок иначе мигал бы каждые 6 секунд.
            -- [ v77 ] Плюс порог в два провала подряд: хостинг иногда отдаёт 502/503 на одну
            -- попытку, и одиночный сбой не должен мигать ошибкой поверх живых значков.
            if ok then
                Automation.BadgeFailStreak = 0
                Automation.BadgeLastError = nil
            else
                Automation.BadgeFailStreak = (Automation.BadgeFailStreak or 0) + 1
                local text = tostring(res)
                if Automation.BadgeFailStreak >= 2 and text ~= Automation.BadgeLastError then
                    Automation.BadgeLastError = text
                    _G.Log("Overmind Users: " .. text, Color3.fromRGB(255, 180, 0))
                    if Internal.ShowIslandNotification then
                        Internal.ShowIslandNotification("BADGE: " .. text, Color3.fromRGB(255, 180, 0))
                    end
                end
            end
            Automation.BadgeApply()
            task.wait(math.clamp(tonumber(Config.Badge.PollSeconds) or 6, 3, 60))
        end
        Automation.BadgeClearAll()
    end)
end

-- ===========================================================================
-- [ v65 ] FRIEND SYSTEM: присутствие друзей через свой сервис (Server/)
-- Раз в ~25 секунд клиент пишет свой статус (кто, где, пинг) на сервер,
-- вкладка «Друзья» читает статусы по UserId и умеет телепортироваться к другу.
-- ===========================================================================

-- [ ВАЖНО ] новых верхнеуровневых local здесь нет: в файле их уже 198 при
-- лимите Luau 200. Всё живёт полями таблиц Automation.* и Internal.*.

Automation.FriendCache = Automation.FriendCache or {}     -- [userId] = статус с сервера
Automation.FriendPlaces = Automation.FriendPlaces or {}   -- [placeId] = название игры
Automation.FriendPushFails = Automation.FriendPushFails or 0

function Automation.FriendEndpoint()
    local url = tostring(Config.Friends.Endpoint or ""):gsub("%s+", "")
    url = url:gsub("/+$", "")
    if url == "" then return nil end
    if not url:match("^https?://") then url = "https://" .. url end
    -- [ v71 ] Схема на этом порту только одна: хостинг отдаёт обычный HTTP, и https к нему
    -- падает на рукопожатии (не кодом ответа, а вообще без ответа). Рабочую схему запоминаем
    -- по строке из настроек, чтобы дальше не пробовать обе на каждом запросе.
    local learned = Automation.FriendScheme and Automation.FriendScheme[url]
    if learned then return learned end
    return url
end

-- Тот же адрес с противоположной схемой (nil, если это не http/https).
function Automation.FriendFlipScheme(url)
    if url:sub(1, 8) == "https://" then return "http://" .. url:sub(9) end
    if url:sub(1, 7) == "http://" then return "https://" .. url:sub(8) end
    return nil
end

function Automation.FriendKeySuffix()
    local key = tostring(Config.Friends.AuthKey or "")
    if key == "" then return "" end
    local encoded = key
    pcall(function() encoded = Core.Services.HttpService:UrlEncode(key) end)
    return "?key=" .. encoded
end

function Automation.FriendUrlEncode(text)
    local encoded = tostring(text or "")
    pcall(function() encoded = Core.Services.HttpService:UrlEncode(encoded) end)
    return encoded
end

-- [ v72 ] Запрос по любому адресу с разбором JSON — тем же транспортом, что и запросы к нашему серверу.
function Automation.FriendHttpJson(method, url, body)
    local raw, err = Automation.FriendSendOnce(method, url, body)
    if not raw then return nil, tostring(err) end
    local ok, data = pcall(function() return Core.Services.HttpService:JSONDecode(raw) end)
    if not ok or type(data) ~= "table" then return nil, "bad json" end
    return data
end

-- [ v72 ] НИК -> UserId. Список друзей и сервер держат UserId (он не меняется, в отличие от ника),
-- но вводить ник удобнее — поэтому ник превращаем в Id: сначала приподнятым API Roblox
-- (если исполнитель дал серверный identity), затем публичным эндпоинтом через транспорт исполнителя.
-- Возвращает (id, ник) или (nil, причина).
function Automation.FriendResolveUserId(text)
    local name = tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then return nil, "empty" end
    if name:match("^%d+$") then return name end
    -- в никах Roblox только буквы, цифры и подчёркивание: остальное отсекаем,
    -- иначе кавычка из поля ввода ломает тело JSON-запроса
    name = name:gsub("[^%w_]", "")
    if name == "" then return nil, "not found" end

    local ok, id = pcall(function() return Core.Services.Players:GetUserIdFromNameAsync(name) end)
    if ok and tonumber(id) and tonumber(id) > 0 then
        return tostring(math.floor(tonumber(id))), name
    end

    local payload = string.format('{"usernames":["%s"],"excludeBannedUsers":false}', name)
    local data, err = Automation.FriendHttpJson("POST", "https://users.roblox.com/v1/usernames/users", payload)
    if data and type(data.data) == "table" then
        local first = data.data[1]
        local found = type(first) == "table" and tonumber(first.id) or nil
        if found and found > 0 then
            return tostring(math.floor(found)), tostring(first.name or first.requestedUsername or name)
        end
        return nil, "not found"   -- API ответил, но такого ника нет
    end

    local legacy, err2 = Automation.FriendHttpJson("GET",
        "https://api.roblox.com/users/get-by-username?username=" .. Automation.FriendUrlEncode(name))
    if legacy and tonumber(legacy.Id) then
        return tostring(math.floor(tonumber(legacy.Id))), tostring(legacy.Username or name)
    end
    return nil, tostring(err or err2 or "not found")
end

-- [ v72 ] UserId -> ник на случай, когда Players:GetNameFromUserIdAsync с клиента не работает.
function Automation.FriendNameFromUserId(userId)
    local ok, name = pcall(function() return Core.Services.Players:GetNameFromUserIdAsync(tonumber(userId)) end)
    if ok and type(name) == "string" and name ~= "" then return name end
    local data = Automation.FriendHttpJson("GET", "https://users.roblox.com/v1/users/" .. tostring(userId))
    if data and type(data.name) == "string" and data.name ~= "" then return tostring(data.name) end
    return nil
end

function Automation.FriendNameOf(userId)
    local id = tostring(userId)
    local data = Automation.FriendCache[id]
    if data and tostring(data.username or "") ~= "" then return tostring(data.username) end
    local cache = Config.Friends.Names or {}
    if tostring(cache[id] or "") ~= "" then return tostring(cache[id]) end
    return "ID " .. id
end

-- online, inGame, sameServer, placeId, jobId
function Automation.FriendFacts(userId)
    local data = Automation.FriendCache[tostring(userId)]
    local online = (data and data.online == true) or false
    local placeId = tonumber(data and data.placeId) or 0
    local jobId = tostring((data and data.gameId) or "")
    local inGame = online and placeId > 0 and jobId ~= ""
    local sameServer = inGame and placeId == tonumber(game.PlaceId) and jobId == tostring(game.JobId)
    return online, inGame, sameServer, placeId, jobId
end

-- [ ПИНГ ] берём тот же, что показывает Dynamic Island
function Automation.FriendPing()
    local ping = tonumber(State.Ping)
    if ping == nil then
        local ok, value = pcall(function()
            return game:GetService("Stats").PerformanceStats.Ping:GetValue()
        end)
        if ok then ping = tonumber(value) end
    end
    ping = math.round(tonumber(ping) or 0)
    if ping < 0 then
        ping = 0
    elseif ping > 60000 then
        ping = 60000
    end
    return ping
end

-- [ v69 ] ТРАНСПОРТ ЗАПРОСОВ.
-- HttpService:PostAsync/GetAsync нельзя вызывать с клиента: сам Roblox отвечает
-- "Http requests can only be executed by game server". Это не блокировщик сервисов и не сервер —
-- поэтому сначала берём функцию исполнителя (request / http_request / syn.request / http.request),
-- а HttpService оставляем последним запасным вариантом: у части исполнителей он подменён и работает.
Automation.FriendTransport = Automation.FriendTransport or false   -- false = ещё не искали, nil = вариантов нет
Automation.FriendScheme = Automation.FriendScheme or {}            -- [адрес из настроек] = схема, которая реально отвечает

function Automation.FriendResolveTransport()
    if Automation.FriendTransport ~= false then return Automation.FriendTransport end
    local found = nil
    pcall(function()
        if type(request) == "function" then
            found = { Name = "request", Fn = request }
        elseif type(http_request) == "function" then
            found = { Name = "http_request", Fn = http_request }
        elseif type(syn) == "table" and type(syn.request) == "function" then
            found = { Name = "syn.request", Fn = syn.request }
        elseif type(http) == "table" and type(http.request) == "function" then
            found = { Name = "http.request", Fn = http.request }
        elseif Core.Services.HttpService and Core.Services.HttpService.PostAsync then
            found = { Name = "HttpService", Fn = nil }
        end
    end)
    Automation.FriendTransport = found or nil
    Automation.FriendTransportName = found and found.Name or "none"
    return found
end

-- Одна попытка конкретным транспортом. Тело ответа или (nil, «почему не вышло»). Никогда не бросает.
function Automation.FriendSendOnce(method, url, body)
    local transport = Automation.FriendResolveTransport()
    if not transport then return nil, "no http transport (need request or http_request)" end

    if transport.Name == "HttpService" then
        local ok, res = pcall(function()
            if method == "GET" then
                return Core.Services.HttpService:GetAsync(url, true)
            end
            return Core.Services.HttpService:PostAsync(url, body or "", Enum.HttpContentType.ApplicationJson)
        end)
        if not ok then return nil, tostring(res) end
        return tostring(res)
    end

    local payload = {
        Url = url,
        Method = method,
        -- [ v73 ] User-Agent как у самого Roblox: часть хостингов режет запросы без
        -- браузерного UA (Cloudflare отвечал 403 error 1010 на клиентов-ботов).
        Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
    }
    if body then payload.Body = body end

    local ok, res = pcall(transport.Fn, payload)
    if not ok then return nil, transport.Name .. ": " .. tostring(res) end
    if type(res) ~= "table" then
        -- [ v71 ] Раньше это молчало «bad response». Показываем, что именно вернул исполнитель:
        -- при https-запросе на http-порт здесь как раз и оказывалось хоть строкой, хоть nil.
        local what = type(res)
        if res ~= nil then what = what .. " " .. tostring(res) end
        return nil, transport.Name .. ": returned " .. what .. " instead of a table (scheme/TLS?)"
    end

    local status = tonumber(res.StatusCode or res.Status) or 0
    if status >= 400 then
        local why = tostring(res.Body or "")
        if #why > 90 then why = string.sub(why, 1, 90) .. "..." end
        if why ~= "" then return nil, "http " .. tostring(status) .. ": " .. why end
        return nil, "http " .. tostring(status)
    end
    if res.Success == false and status == 0 then
        return nil, transport.Name .. ": " .. tostring(res.Body or "request failed")
    end
    return tostring(res.Body or "")
end

-- Возвращает тело ответа или (nil, «почему не вышло»). Никогда не бросает исключение.
-- [ v71 ] Адрес собирается здесь из базы и пути: только так можно один раз перепробовать обе схемы
-- и запомнить рабочую. Клиент раньше жёстко брал схему из настроек, а сервер отвечает только по http.
function Automation.FriendHttpRequest(method, path, body)
    local base = Automation.FriendEndpoint()
    if not base then return nil, "no server url" end

    local urls = { base }
    local alt = Automation.FriendFlipScheme(base)
    if alt and alt ~= base then table.insert(urls, alt) end

    local lastErr = "no response"
    for i = 1, #urls do
        local got, why = Automation.FriendSendOnce(method, urls[i] .. path, body)
        if got then
            if i > 1 then
                -- Заданная схема не ответила, вторая ответила — дальше держимся рабочей.
                Automation.FriendScheme = Automation.FriendScheme or {}
                Automation.FriendScheme[base] = urls[i]
            end
            return got
        end
        lastErr = why
    end
    return nil, tostring(lastErr)
end

function Automation.FriendPush()
    if not Automation.FriendEndpoint() then return false, "no server url" end
    local lp = Core.LocalPlayer
    if not lp then return false, "no local player" end

    local payload = {
        userId = tostring(lp.UserId),
        username = tostring(lp.Name),
        placeId = tostring(game.PlaceId or 0),
        gameId = tostring(game.JobId or ""),
        ping = Automation.FriendPing(),
    }
    local okEncode, body = pcall(function() return Core.Services.HttpService:JSONEncode(payload) end)
    if not okEncode or type(body) ~= "string" then return false, "encode failed" end

    local res, httpErr = Automation.FriendHttpRequest("POST", "/update-status" .. Automation.FriendKeySuffix(), body)
    if not res then return false, tostring(httpErr) end
    Automation.FriendLastPush = os.time()
    return true, tostring(res)
end

function Automation.FriendFetch(userId)
    if not Automation.FriendEndpoint() then return nil, "no server url" end
    local body, httpErr = Automation.FriendHttpRequest("GET", "/get-status/" .. tostring(userId) .. Automation.FriendKeySuffix())
    if not body then return nil, tostring(httpErr) end
    local okDecode, data = pcall(function() return Core.Services.HttpService:JSONDecode(body) end)
    if not okDecode or type(data) ~= "table" then return nil, "bad response" end
    return data
end

-- ===========================================================================
-- [ v75 ] ЛИЧНЫЙ СПИСОК ДРУЗЕЙ НА АККАУНТ И ЗАЯВКИ В ДРУЗЬЯ
-- Папка исполнителя одна на машину, а аккаунтов несколько — поэтому список друзей, имена
-- и заявки у каждого аккаунта лежат в своей папке Overmind/Accounts/<UserId>/friends.json.
-- Добавление теперь идёт по согласию: заявка ждёт на сервере, пока вторая сторона не примет
-- или не отклонит её во вкладке Requests.
-- ===========================================================================
Automation.FriendRequests = Automation.FriendRequests or {}   -- входящие: [id] = { name, age }
Automation.FriendOutgoing = Automation.FriendOutgoing or {}   -- исходящие: [id] = true
Automation.FriendLinks = Automation.FriendLinks or {}         -- согласованные связи с сервера: [id] = true

function Automation.FriendStoreDir()
    local lp = Core.LocalPlayer
    if not lp then return nil end
    return "Overmind/Accounts/" .. tostring(lp.UserId)
end

function Automation.FriendsStorePath()
    local dir = Automation.FriendStoreDir()
    if not dir then return nil end
    return dir .. "/friends.json"
end

-- Запись личного файла: список, имена, заявки, связи. Молча отдаёт false, если writefile недоступен.
function Automation.FriendsStoreWrite()
    local path = Automation.FriendsStorePath()
    if not path or not writefile then return false, "no writefile" end
    local data = {
        list = Config.Friends.List or {},
        names = Config.Friends.Names or {},
        requests = Automation.FriendRequests or {},
        outgoing = Automation.FriendOutgoing or {},
        links = Automation.FriendLinks or {},
        updated = os.time(),
    }
    local okEncode, text = pcall(function() return Core.Services.HttpService:JSONEncode(data) end)
    if not okEncode or type(text) ~= "string" then return false, "encode failed" end
    if makefolder then
        local dir = Automation.FriendStoreDir()
        if dir then pcall(function() makefolder(dir) end) end
    end
    local okWrite, err = pcall(function() writefile(path, text) end)
    if not okWrite then return false, tostring(err) end
    return true
end

-- Чтение личного файла. Игрок без файла получает пустой список и файл создаётся при первом изменении.
function Automation.FriendsStoreRead()
    local path = Automation.FriendsStorePath()
    if not path or not (isfile and readfile) then return false end
    local okFile = pcall(function() return isfile(path) end)
    if not okFile then return false end
    local okRead, text = pcall(readfile, path)
    if not okRead or type(text) ~= "string" or text == "" then return false end
    local okDecode, data = pcall(function() return Core.Services.HttpService:JSONDecode(text) end)
    if not okDecode or type(data) ~= "table" then return false end

    local list = {}
    for _, raw in ipairs(data.list or {}) do
        local id = tostring(raw)
        if id:match("^%d+$") then table.insert(list, tonumber(id) or id) end
    end
    Config.Friends.List = list
    Config.Friends.Names = (type(data.names) == "table") and data.names or {}
    Automation.FriendRequests = (type(data.requests) == "table") and data.requests or {}
    Automation.FriendOutgoing = (type(data.outgoing) == "table") and data.outgoing or {}
    Automation.FriendLinks = (type(data.links) == "table") and data.links or {}
    return true
end

-- Один раз на аккаунт: если файла нет — создаём его из текущего состояния конфига.
function Automation.FriendsStoreEnsure()
    local me = tostring(Core.LocalPlayer and Core.LocalPlayer.UserId or "")
    if me == "" or Automation.FriendsStoreLoaded == me then return end
    Automation.FriendsStoreLoaded = me
    if Automation.FriendsStoreRead() then
        _G.Log("Friends: loaded account " .. me .. " - " .. tostring(#(Config.Friends.List or {})) .. " friend(s)",
            Color3.fromRGB(0, 200, 255))
    else
        Automation.FriendsStoreWrite()
    end
end

-- [ ЗАЯВКА ] отправка: сервер хранит её, пока вторая сторона не ответит.
function Automation.FriendHttpJsonBody(fields)
    local okEncode, body = pcall(function() return Core.Services.HttpService:JSONEncode(fields) end)
    if not okEncode or type(body) ~= "string" then return nil end
    return body
end

function Automation.FriendRequestSend(userId)
    local lp = Core.LocalPlayer
    if not lp then return false, "no local player" end
    if not Automation.FriendEndpoint() then return false, "no server url" end

    local me = tostring(lp.UserId)
    local to = tostring(userId or "")
    if to == me then return false, "self" end

    local body = Automation.FriendHttpJsonBody({ from = me, fromName = tostring(lp.Name), to = to })
    if not body then return false, "encode failed" end
    local raw, err = Automation.FriendHttpRequest("POST", "/friend-request", body)
    if not raw then return false, tostring(err) end
    local okDecode, data = pcall(function() return Core.Services.HttpService:JSONDecode(raw) end)
    if not okDecode or type(data) ~= "table" then return false, "bad response" end

    local state = tostring(data.state or "sent")
    if state == "sent" then Automation.FriendOutgoing[to] = true end
    Automation.FriendsStoreWrite()
    return true, state
end

-- [ ОТВЕТ ] принять или отклонить заявку; при принятии связь появляется у обоих.
function Automation.FriendRespond(fromId, accept)
    local lp = Core.LocalPlayer
    if not lp then return false, "no local player" end
    local from = tostring(fromId or "")
    if not from:match("^%d+$") then return false, "bad id" end

    local request = Automation.FriendRequests[from]
    local requestName = type(request) == "table" and request.name or nil
    local body = Automation.FriendHttpJsonBody({
        from = from,
        to = tostring(lp.UserId),
        accept = accept and true or false,
    })
    if not body then return false, "encode failed" end

    local raw, err = Automation.FriendHttpRequest("POST", "/friend-request/respond", body)
    if not raw then return false, tostring(err) end
    local okDecode, data = pcall(function() return Core.Services.HttpService:JSONDecode(raw) end)
    if not okDecode or type(data) ~= "table" then return false, "bad response" end

    Automation.FriendRequests[from] = nil
    if accept then
        Automation.FriendLinks[from] = true
        Automation.FriendOutgoing[from] = nil
        Internal.FriendsAddById(from, requestName)
    else
        Internal.FriendsNotify("REQUEST FROM " .. from .. " DECLINED", true)
    end
    Automation.FriendsStoreWrite()
    if Internal.FriendsRender then Internal.FriendsRender() end
    return true, accept and "accepted" or "declined"
end

-- [ РАЗРЫВ ] снять связь на сервере, чтобы партнёр не добавил тебя обратно сам.
function Automation.FriendUnlink(userId)
    local lp = Core.LocalPlayer
    if not lp or not Automation.FriendEndpoint() then return false end
    local body = Automation.FriendHttpJsonBody({ from = tostring(lp.UserId), to = tostring(userId or "") })
    if not body then return false end
    Automation.FriendLinks[tostring(userId)] = nil
    Automation.FriendUnlinkQueue = Automation.FriendUnlinkQueue or {}
    table.insert(Automation.FriendUnlinkQueue, body)
    if Automation.FriendUnlinkBusy then return true end
    Automation.FriendUnlinkBusy = true
    task.spawn(function()
        while #(Automation.FriendUnlinkQueue or {}) > 0 do
            local queued = table.remove(Automation.FriendUnlinkQueue, 1)
            Automation.FriendHttpRequest("POST", "/friend-remove", queued)
            task.wait(0.2)
        end
        Automation.FriendUnlinkBusy = false
        Automation.FriendsStoreWrite()
    end)
    return true
end

-- [ ОПРОС ЗАЯВОК ] входящие, исходящие и согласованные связи с сервера.
function Automation.FriendRequestsRefresh()
    if Automation.FriendRequestsBusy then return end
    local lp = Core.LocalPlayer
    if not lp or not Automation.FriendEndpoint() then return end
    Automation.FriendRequestsBusy = true
    task.spawn(function()
        local raw = Automation.FriendHttpRequest("GET",
            "/friend-requests?userId=" .. tostring(lp.UserId) .. Automation.FriendKeySuffix())
        if raw then
            local okDecode, data = pcall(function() return Core.Services.HttpService:JSONDecode(raw) end)
            if okDecode and type(data) == "table" then
                local incoming, outgoing, links = {}, {}, {}
                for _, item in ipairs(data.incoming or {}) do
                    local id = tostring(item and item.from or "")
                    if id:match("^%d+$") then
                        incoming[id] = { name = tostring(item.name or ""), age = tonumber(item.ageSeconds) or 0 }
                    end
                end
                for _, item in ipairs(data.outgoing or {}) do
                    local id = tostring(item and item.to or "")
                    if id:match("^%d+$") then outgoing[id] = true end
                end
                for _, item in ipairs(data.friends or {}) do
                    local id = tostring(item and item.userId or "")
                    if id:match("^%d+$") then links[id] = true end
                end

                Automation.FriendRequests = incoming
                Automation.FriendOutgoing = outgoing

                -- согласованную связь добавляем себе сами: вторая сторона уже приняла
                for id in pairs(links) do
                    if not Automation.FriendLinks[id] then
                        Automation.FriendLinks[id] = true
                        local known = (Config.Friends.Names or {})[id]
                        local pending = (incoming[id] and incoming[id].name) or ""
                        if not Internal.FriendsHas(id) then
                            Internal.FriendsAddById(id, known ~= "" and known or pending)
                        end
                    end
                end
                -- связь разорвали с той стороны — убираем у себя
                for id in pairs(Automation.FriendLinks) do
                    if not links[id] then
                        Automation.FriendLinks[id] = nil
                        Internal.FriendsRemoveLocal(id)
                    end
                end

                Automation.FriendsStoreWrite()
                if Internal.FriendsRender then Internal.FriendsRender() end
            end
        end
        Automation.FriendRequestsBusy = false
    end)
end

-- [ ОПРОС ВСЕХ ] четыре параллельных воркера, чтобы не ждать друзей по очереди
function Automation.FriendPollOnce(waitFor)
    local pending = {}
    for _, id in ipairs(Config.Friends.List or {}) do
        table.insert(pending, tostring(id))
    end
    if #pending == 0 then return end

    local cursor = { index = 0 }
    local workers = {}
    for _ = 1, math.clamp(#pending, 1, 4) do
        table.insert(workers, task.spawn(function()
            while true do
                cursor.index = cursor.index + 1
                local id = pending[cursor.index]
                if not id then return end
                local data, err = Automation.FriendFetch(id)
                if data then
                    Automation.FriendCache[id] = {
                        online = data.online == true,
                        username = tostring(data.username or ""),
                        placeId = tostring(data.placeId or 0),
                        gameId = tostring(data.gameId or ""),
                        ping = tonumber(data.ping) or 0,
                        ageSeconds = tonumber(data.ageSeconds) or 0,
                        lastSeen = tonumber(data.lastSeen) or 0,
                        error = nil,
                    }
                    local name = tostring(data.username or "")
                    if data.online == true and name ~= "" then
                        Config.Friends.Names = Config.Friends.Names or {}
                        Config.Friends.Names[id] = name
                    end
                else
                    local cached = Automation.FriendCache[id] or {}
                    cached.online = false
                    cached.error = tostring(err)
                    Automation.FriendCache[id] = cached
                end
            end
        end))
    end

    if waitFor then
        for _, worker in ipairs(workers) do
            while coroutine.status(worker) ~= "dead" do
                task.wait(0.05)
            end
        end
    end
end

-- [ ИМЕНА ] у офлайн-друзей имя тянем по UserId и держим в конфиге
function Automation.FriendResolveNames()
    if Automation.FriendNamesBusy then return end
    Automation.FriendNamesBusy = true
    task.spawn(function()
        Config.Friends.Names = Config.Friends.Names or {}
        for _, rawId in ipairs(Config.Friends.List or {}) do
            local id = tostring(rawId)
            if Config.Friends.Names[id] == nil then
                -- [ v72 ] имя пробуем двумя путями (см. Automation.FriendNameFromUserId)
                local name = Automation.FriendNameFromUserId(id)
                if type(name) == "string" and name ~= "" then
                    Config.Friends.Names[id] = name
                else
                    Config.Friends.Names[id] = ""
                end
                task.wait(0.4)
            end
        end
        Automation.FriendNamesBusy = false
        if Internal.FriendsRender then Internal.FriendsRender() end
    end)
end

-- [ НАЗВАНИЕ ИГРЫ ] по PlaceId, с кэшем; ошибку показываем как "Place <id>"
function Automation.FriendPlaceName(placeId)
    local id = tostring(placeId or "0")
    if id == "" or id == "0" then return nil end
    if Automation.FriendPlaces[id] then return Automation.FriendPlaces[id] end
    Automation.FriendPlacesPending = Automation.FriendPlacesPending or {}
    if not Automation.FriendPlacesPending[id] then
        Automation.FriendPlacesPending[id] = true
        task.spawn(function()
            local ok, info = pcall(function()
                return Core.Services.MarketplaceService:GetProductInfo(tonumber(id), Enum.InfoType.Asset)
            end)
            local name = nil
            if ok and type(info) == "table" and type(info.Name) == "string" and info.Name ~= "" then
                name = tostring(info.Name)
            end
            Automation.FriendPlaces[id] = name or ("Place " .. id)
            Automation.FriendPlacesPending[id] = nil
            if Internal.FriendsRender then Internal.FriendsRender() end
        end)
    end
    return nil
end

function Automation.FriendStatusText(userId)
    local data = Automation.FriendCache[tostring(userId)]
    if not data then return "Status unknown", Color3.fromRGB(107, 114, 128) end

    local online, inGame, sameServer, placeId = Automation.FriendFacts(userId)
    if not online then
        local lastSeen = tonumber(data.lastSeen) or 0
        if lastSeen > 0 then
            local minutes = math.floor((os.time() - math.floor(lastSeen / 1000)) / 60)
            if minutes < 1 then minutes = 1 end
            return "Offline - seen " .. tostring(minutes) .. " min ago", Color3.fromRGB(107, 114, 128)
        end
        return "Offline", Color3.fromRGB(107, 114, 128)
    end

    local pingText = ""
    local ping = tonumber(data.ping) or 0
    if ping > 0 then pingText = " - " .. tostring(math.round(ping)) .. " ms" end

    if sameServer then
        return "In game - same server as you" .. pingText, Color3.fromRGB(74, 222, 128)
    end
    if inGame then
        local placeName = Automation.FriendPlaceName(placeId) or ("Place " .. tostring(placeId))
        return "In game - " .. placeName .. pingText, Color3.fromRGB(74, 222, 128)
    end
    return "Online - in menus" .. pingText, Color3.fromRGB(251, 191, 36)
end

-- [ JOIN ] телепорт на конкретный сервер игры, где сидит друг
function Automation.FriendJoin(userId)
    local id = tostring(userId)
    local online, inGame, sameServer, placeId, jobId = Automation.FriendFacts(id)
    if not online then return false, "FRIEND IS OFFLINE" end
    if sameServer then return false, "YOU ARE ON THE SAME SERVER" end
    if not inGame then return false, "FRIEND IS NOT IN A GAME" end
    local ok, err = pcall(function()
        Core.Services.TeleportService:TeleportToPlaceInstance(placeId, jobId, Core.LocalPlayer)
    end)
    if not ok then return false, "TELEPORT FAILED: " .. tostring(err) end
    return true, "JOINING FRIEND"
end

